<Window x:Class="WindowsDynamicIsland.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Dynamic Island"
        Width="500"
        Height="250"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        AllowDrop="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid x:Name="RootCanvas"
          Background="Transparent"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Top">

        <!-- Ambient Dynamic Glow Behind Pill -->
        <Border x:Name="AmbientGlowBorder"
                Width="168"
                Height="34"
                CornerRadius="17"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,8,0,0"
                Opacity="0.0"
                IsHitTestVisible="False">
            <Border.Background>
                <SolidColorBrush x:Name="AmbientGlowBrush" Color="#38BDF8"/>
            </Border.Background>
            <Border.Effect>
                <BlurEffect Radius="24" KernelType="Gaussian"/>
            </Border.Effect>
        </Border>

        <!-- Main Morphing Dynamic Island Pill -->
        <Border x:Name="IslandBorder"
                Width="174"
                Height="34"
                CornerRadius="17"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,8,0,0"
                Background="#09090C"
                BorderBrush="#2AFFFFFF"
                BorderThickness="1"
                ClipToBounds="True"
                MouseEnter="OnIslandMouseEnter"
                MouseLeave="OnIslandMouseLeave"
                MouseLeftButtonUp="OnIslandMouseLeftButtonUp"
                MouseRightButtonUp="OnIslandMouseRightButtonUp"
                MouseDown="OnIslandMouseDown"
                MouseWheel="OnIslandMouseWheel"
                DragEnter="OnIslandDragEnter"
                DragOver="OnIslandDragOver"
                Drop="OnIslandDrop">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.65" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <!-- Subtle top specular highlight -->
                <Border VerticalAlignment="Top"
                        Height="1"
                        Margin="14,0,14,0"
                        IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00FFFFFF" Offset="0.0"/>
                            <GradientStop Color="#38FFFFFF" Offset="0.5"/>
                            <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- STATE 1: IDLE PILL (Clock + Privacy Dots + Battery) -->
                <Grid x:Name="IdlePillPanel"
                      Margin="14,0,14,0"
                      Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="IdlePulseDot"
                                 Width="6" Height="6"
                                 Fill="#38BDF8"
                                 Margin="0,0,7,0"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="ClockTextBlock"
                                   Text="14:25"
                                   Foreground="#F8FAFC"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Privacy Indicators (Camera = Green, Microphone = Orange) -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Ellipse x:Name="CameraPrivacyDot"
                                 Width="7" Height="7"
                                 Fill="#22C55E"
                                 Margin="3,0"
                                 ToolTip="Kamera sedang aktif"
                                 Visibility="Collapsed"/>
                        <Ellipse x:Name="MicPrivacyDot"
                                 Width="7" Height="7"
                                 Fill="#F97316"
                                 Margin="3,0"
                                 ToolTip="Mikrofon sedang aktif"
                                 Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- Battery / Status Right Side -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="IdleBatteryIconText"
                                   Text="⚡"
                                   FontSize="10"
                                   Foreground="#22C55E"
                                   Margin="0,0,4,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="IdleBatteryPercentText"
                                   Text="100%"
                                   Foreground="#CBD5E1"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- STATE 2: COMPACT MEDIA PILL (Album Thumbnail + Track Title + Live 5-Bar Waveform) -->
                <Grid x:Name="CompactMediaPanel"
                      Margin="10,0,12,0"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Mini Album Cover -->
                    <Border Grid.Column="0"
                            Width="22" Height="22"
                            CornerRadius="6"
                            Background="#1E293B"
                            VerticalAlignment="Center"
                            ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="♪"
                                       Foreground="#94A3B8"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <Image x:Name="CompactAlbumImage" Stretch="UniformToFill"/>
                        </Grid>
                    </Border>

                    <!-- Compact Song Title -->
                    <TextBlock x:Name="CompactSongTitleText"
                               Grid.Column="1"
                               Text="Sedang Memutar..."
                               Foreground="#F1F5F9"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Margin="9,0,9,0"
                               VerticalAlignment="Center"/>

                    <!-- 5-Bar Real-Time WASAPI Audio Spectrum -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Height="18">
                        <Rectangle x:Name="WaveBar0" Width="3" Height="6" RadiusX="1.5" RadiusY="1.5" Fill="#38BDF8" Margin="1.2,0" VerticalAlignment="Center"/>
                        <Rectangle x:Name="WaveBar1" Width="3" Height="12" RadiusX="1.5" RadiusY="1.5" Fill="#38BDF8" Margin="1.2,0" VerticalAlignment="Center"/>
                        <Rectangle x:Name="WaveBar2" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="#38BDF8" Margin="1.2,0" VerticalAlignment="Center"/>
                        <Rectangle x:Name="WaveBar3" Width="3" Height="10" RadiusX="1.5" RadiusY="1.5" Fill="#38BDF8" Margin="1.2,0" VerticalAlignment="Center"/>
                        <Rectangle x:Name="WaveBar4" Width="3" Height="5" RadiusX="1.5" RadiusY="1.5" Fill="#38BDF8" Margin="1.2,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- STATE 3: TOAST INTERRUPT PILL (Volume, CapsLock, Charger, Clipboard, Timer) -->
                <Grid x:Name="ToastPanel"
                      Margin="14,0,14,0"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="ToastIconBadge"
                            Grid.Column="0"
                            Width="26" Height="26"
                            CornerRadius="8"
                            Background="#2438BDF8"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                        <TextBlock x:Name="ToastIconText"
                                   Text="🔊"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="ToastTitleText"
                                   Text="Volume 75%"
                                   Foreground="#F8FAFC"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ToastSubtitleText"
                                   Text="Scroll mouse untuk mengatur"
                                   Foreground="#94A3B8"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Border x:Name="ToastProgressContainer"
                            Grid.Column="2"
                            Width="58" Height="6"
                            CornerRadius="3"
                            Background="#26FFFFFF"
                            VerticalAlignment="Center"
                            Margin="10,0,0,0"
                            Visibility="Collapsed">
                        <Border x:Name="ToastProgressFill"
                                HorizontalAlignment="Left"
                                Width="35"
                                Height="6"
                                CornerRadius="3"
                                Background="#38BDF8"/>
                    </Border>
                </Grid>

                <!-- STATE 4: EXPANDED DASHBOARD (Multi-Tab Hub) -->
                <Grid x:Name="ExpandedDashboardPanel"
                      Margin="16,10,16,12"
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Switcher Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button x:Name="TabMediaBtn"
                                    Style="{StaticResource TabPillButtonStyle}"
                                    Content="🎵 Musik &amp; Lirik"
                                    Click="OnTabMediaClick"/>
                            <Button x:Name="TabShelfBtn"
                                    Style="{StaticResource TabPillButtonStyle}"
                                    Content="📂 File Shelf"
                                    Click="OnTabShelfClick"/>
                            <Button x:Name="TabPomodoroBtn"
                                    Style="{StaticResource TabPillButtonStyle}"
                                    Content="⏱️ Fokus"
                                    Click="OnTabPomodoroClick"/>
                            <Button x:Name="TabSystemBtn"
                                    Style="{StaticResource TabPillButtonStyle}"
                                    Content="⚡ Sistem"
                                    Click="OnTabSystemClick"/>
                        </StackPanel>

                        <TextBlock x:Name="ExpandedClockBadge"
                                   Grid.Column="1"
                                   Text="14:25"
                                   Foreground="#64748B"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- TAB 0: MEDIA CONTROLLER + SYNCHRONIZED LRCLIB LYRICS -->
                    <Grid x:Name="MediaTabGrid" Grid.Row="1" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Album Art + Song Metadata + Transport Buttons -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="54" Height="54"
                                    CornerRadius="12"
                                    Background="#1E293B"
                                    BorderBrush="#28FFFFFF"
                                    BorderThickness="1"
                                    ClipToBounds="True">
                                <Grid>
                                    <TextBlock Text="🎵"
                                               FontSize="22"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <Image x:Name="ExpandedAlbumImage" Stretch="UniformToFill"/>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,2,10,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ExpandedSongTitleText"
                                           Text="Tidak Ada Media Aktif"
                                           Foreground="#F8FAFC"
                                           FontSize="13.5"
                                           FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ExpandedArtistText"
                                           Text="Putar lagu di Spotify, Chrome, Edge, atau VLC"
                                           Foreground="#94A3B8"
                                           FontSize="11.5"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource IslandIconButtonStyle}"
                                        Width="30" Height="30"
                                        Margin="2,0"
                                        Content="⏮"
                                        ToolTip="Lagu Sebelumnya"
                                        Click="OnMediaPrevClick"/>
                                <Button x:Name="PlayPauseButton"
                                        Style="{StaticResource IslandIconButtonStyle}"
                                        Width="34" Height="34"
                                        Margin="3,0"
                                        Content="▶"
                                        FontSize="13"
                                        ToolTip="Play / Pause (atau Klik Tengah)"
                                        Click="OnMediaPlayPauseClick"/>
                                <Button Style="{StaticResource IslandIconButtonStyle}"
                                        Width="30" Height="30"
                                        Margin="2,0"
                                        Content="⏭"
                                        ToolTip="Lagu Berikutnya"
                                        Click="OnMediaNextClick"/>
                            </StackPanel>
                        </Grid>

                        <!-- Timeline Scrubber Bar -->
                        <Grid Grid.Row="1" Margin="0,9,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="ElapsedTimeText"
                                       Grid.Column="0"
                                       Text="0:00"
                                       Foreground="#64748B"
                                       FontSize="10"
                                       VerticalAlignment="Center"/>

                            <Border x:Name="TimelineTrackBorder"
                                    Grid.Column="1"
                                    Height="5"
                                    CornerRadius="2.5"
                                    Background="#22FFFFFF"
                                    Margin="8,0"
                                    VerticalAlignment="Center">
                                <Border x:Name="TimelineFillBorder"
                                        HorizontalAlignment="Left"
                                        Width="0"
                                        Height="5"
                                        CornerRadius="2.5"
                                        Background="#38BDF8"/>
                            </Border>

                            <TextBlock x:Name="TotalDurationText"
                                       Grid.Column="2"
                                       Text="0:00"
                                       Foreground="#64748B"
                                       FontSize="10"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Live Synchronized Lyrics Box (LRCLIB) -->
                        <Border Grid.Row="2"
                                Background="#12FFFFFF"
                                BorderBrush="#1AFFFFFF"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10,6">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="CurrentLyricLineText"
                                           Text="♪ Lirik otomatis muncul saat lagu diputar"
                                           Foreground="#F8FAFC"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="NextLyricLineText"
                                           Text="Mendukung sinkronisasi waktu real-time via LRCLIB"
                                           Foreground="#64748B"
                                           FontSize="10.5"
                                           Margin="0,2,0,0"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- TAB 1: TEMPORARY FILE DROP SHELF (STASH) -->
                    <Grid x:Name="ShelfTabGrid" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock x:Name="ShelfHeaderCountText"
                                       Text="Taruh file sementara di sini (Drag Masuk &amp; Keluar)"
                                       Foreground="#94A3B8"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                            <Button Style="{StaticResource IslandIconButtonStyle}"
                                    HorizontalAlignment="Right"
                                    Padding="8,3"
                                    FontSize="10.5"
                                    Content="Bersihkan"
                                    Click="OnClearShelfClick"/>
                        </Grid>

                        <Border Grid.Row="1"
                                Background="#12FFFFFF"
                                BorderBrush="#24FFFFFF"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="8">
                            <Grid>
                                <TextBlock x:Name="EmptyShelfHintText"
                                           Text="📥 Drag file dari File Explorer ke Dynamic Island untuk disimpan sementara, lalu tarik keluar ke WhatsApp / Discord / Browser."
                                           Foreground="#64748B"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="16,0"/>

                                <ItemsControl x:Name="ShelfItemsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#20FFFFFF"
                                                    BorderBrush="#30FFFFFF"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="8,5"
                                                    Margin="3"
                                                    Cursor="Hand"
                                                    ToolTip="Drag keluar untuk memindahkan file ke aplikasi lain"
                                                    MouseMove="OnShelfItemMouseMove">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding IconGlyph}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <StackPanel MaxWidth="115">
                                                        <TextBlock Text="{Binding FileName}"
                                                                   Foreground="#F8FAFC"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding SizeLabel}"
                                                                   Foreground="#94A3B8"
                                                                   FontSize="9.5"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- TAB 2: POMODORO & FOCUS TIMER -->
                    <Grid x:Name="PomodoroTabGrid" Grid.Row="1" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="118" Height="98"
                                Background="#14FFFFFF"
                                BorderBrush="#26FFFFFF"
                                BorderThickness="1"
                                CornerRadius="14"
                                Margin="0,0,12,0">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="PomodoroModeLabel"
                                           Text="SESI FOKUS"
                                           Foreground="#38BDF8"
                                           FontSize="9.5"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="PomodoroTimeText"
                                           Text="25:00"
                                           Foreground="#F8FAFC"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,2"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Kontrol Timer Produktivitas"
                                       Foreground="#CBD5E1"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <WrapPanel>
                                <Button x:Name="PomodoroStartPauseBtn"
                                        Style="{StaticResource IslandIconButtonStyle}"
                                        Padding="12,6"
                                        Margin="0,0,6,6"
                                        Content="▶ Mulai"
                                        FontWeight="SemiBold"
                                        Click="OnPomodoroStartPauseClick"/>
                                <Button Style="{StaticResource IslandIconButtonStyle}"
                                        Padding="10,6"
                                        Margin="0,0,6,6"
                                        Content="Fokus 25m"
                                        Click="OnPomodoroResetFocusClick"/>
                                <Button Style="{StaticResource IslandIconButtonStyle}"
                                        Padding="10,6"
                                        Margin="0,0,6,6"
                                        Content="Break 5m"
                                        Click="OnPomodoroBreakClick"/>
                                <Button Style="{StaticResource IslandIconButtonStyle}"
                                        Padding="10,6"
                                        Margin="0,0,6,6"
                                        Content="+5m"
                                        Click="OnPomodoroAdd5MinClick"/>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>

                    <!-- TAB 3: SYSTEM TELEMETRY, PRIVACY & ISLAND CONTROLS -->
                    <Grid x:Name="SystemTabGrid" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="#14FFFFFF"
                                    CornerRadius="10"
                                    Padding="10,7"
                                    Margin="0,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="BATERAI &amp; JARINGAN" Foreground="#64748B" FontSize="9.5" FontWeight="Bold"/>
                                    <TextBlock x:Name="SysBatteryDetailText"
                                               Text="⚡ 100% (AC Connected)"
                                               Foreground="#F8FAFC"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Margin="0,2,0,0"/>
                                    <TextBlock x:Name="SysNetworkDetailText"
                                               Text="Wi-Fi Terhubung"
                                               Foreground="#94A3B8"
                                               FontSize="10"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Background="#14FFFFFF"
                                    CornerRadius="10"
                                    Padding="10,7"
                                    Margin="4,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="PRIVASI &amp; MEMORI" Foreground="#64748B" FontSize="9.5" FontWeight="Bold"/>
                                    <TextBlock x:Name="SysPrivacyDetailText"
                                               Text="🛡️ Kamera &amp; Mic Aman"
                                               Foreground="#22C55E"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Margin="0,2,0,0"/>
                                    <TextBlock x:Name="SysMemoryDetailText"
                                               Text="RAM Island: ~26 MB (0% Idle)"
                                               Foreground="#94A3B8"
                                               FontSize="10"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,2,0,0">
                            <Button x:Name="ToggleMuteBtn"
                                    Style="{StaticResource IslandIconButtonStyle}"
                                    Padding="10,6"
                                    Margin="0,0,6,0"
                                    FontSize="11"
                                    Content="🔊 Mute Audio"
                                    Click="OnToggleMuteClick"/>
                            <Button x:Name="ToggleNotchModeBtn"
                                    Style="{StaticResource IslandIconButtonStyle}"
                                    Padding="10,6"
                                    Margin="0,0,6,0"
                                    FontSize="11"
                                    Content="🏝️ Mode: Floating Pill"
                                    Click="OnToggleNotchModeClick"/>
                            <Button Style="{StaticResource IslandIconButtonStyle}"
                                    Padding="10,6"
                                    FontSize="11"
                                    Foreground="#F87171"
                                    Content="✖ Keluar"
                                    Click="OnExitAppClick"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

