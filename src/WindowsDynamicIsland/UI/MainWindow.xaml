<Window x:Class="WindowsDynamicIsland.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Dynamic Island"
        Width="600"
        Height="310"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        AllowDrop="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid x:Name="RootCanvas"
          Background="{x:Null}"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Top">

        <!-- Soft Ambient Glow Behind the Unified Notch -->
        <Border x:Name="AmbientGlowBorder"
                Width="196"
                Height="36"
                CornerRadius="0,0,18,18"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,0,0,0"
                Opacity="0.0"
                IsHitTestVisible="False">
            <Border.Background>
                <SolidColorBrush x:Name="AmbientGlowBrush" Color="#38BDF8"/>
            </Border.Background>
            <Border.Effect>
                <BlurEffect Radius="24" KernelType="Gaussian"/>
            </Border.Effect>
        </Border>

        <!-- SINGLE UNIFIED NOTCHNOOK SILHOUETTE (Gambar 2 Reference: Satu desain utuh menempel di atas layar) -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
            <!-- One-piece pure black NotchNook shape with top concave ears & bottom rounded corners -->
            <Path x:Name="UnifiedNotchPath"
                  Fill="#030305"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  IsHitTestVisible="False">
                <Path.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.72" Color="#000000"/>
                </Path.Effect>
            </Path>

            <!-- Subtle contour rim along the sides and bottom only (never creates a separate oval!) -->
            <Path x:Name="UnifiedNotchRimPath"
                  Stroke="#1EFFFFFF"
                  StrokeThickness="1"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  IsHitTestVisible="False"/>

            <!-- Interactive Content Host (Transparent background & 0 border so it is 100% one piece with UnifiedNotchPath) -->
            <Border x:Name="IslandBorder"
                    Width="196"
                    Height="36"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,0,0,0"
                    Background="#01000000"
                    BorderThickness="0"
                    ClipToBounds="True"
                    MouseEnter="OnIslandMouseEnter"
                    MouseLeave="OnIslandMouseLeave"
                    MouseLeftButtonUp="OnIslandMouseLeftButtonUp"
                    MouseRightButtonUp="OnIslandMouseRightButtonUp"
                    MouseDown="OnIslandMouseDown"
                    MouseWheel="OnIslandMouseWheel"
                    DragEnter="OnIslandDragEnter"
                    DragOver="OnIslandDragOver"
                    Drop="OnIslandDrop">

                <Grid>
                    <!-- STATE 0: TUCKED TOP EDGE HANDLE ("Tersimpan di Atas") -->
                    <Grid x:Name="TuckedHandlePanel"
                          Visibility="Collapsed"
                          Cursor="Hand"
                          ToolTip="Dynamic Island tersimpan di atas (Klik untuk membuka)">
                        <Border x:Name="TuckedAccentBar"
                                Width="68"
                                Height="3"
                                CornerRadius="1.5"
                                Background="#38BDF8"
                                Opacity="0.88"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                    </Grid>

                    <!-- STATE 1: IDLE PILL (Clock + Privacy Dots + Battery) -->
                    <Grid x:Name="IdlePillPanel"
                          Margin="16,0,16,2"
                          Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="IdlePulseDot"
                                     Width="6.5" Height="6.5"
                                     Fill="#38BDF8"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="ClockTextBlock"
                                       Text="14:25"
                                       Foreground="#F8FAFC"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Privacy Indicators (Camera = Green, Microphone = Orange) -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Ellipse x:Name="CameraPrivacyDot"
                                     Width="7.5" Height="7.5"
                                     Fill="#22C55E"
                                     Margin="3,0"
                                     ToolTip="Kamera sedang aktif"
                                     Visibility="Collapsed"/>
                            <Ellipse x:Name="MicPrivacyDot"
                                     Width="7.5" Height="7.5"
                                     Fill="#F97316"
                                     Margin="3,0"
                                     ToolTip="Mikrofon sedang aktif"
                                     Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- Battery / Status Right Side -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="IdleBatteryIconText"
                                       Text="⚡"
                                       FontSize="10.5"
                                       Foreground="#22C55E"
                                       Margin="0,0,4,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="IdleBatteryPercentText"
                                       Text="100%"
                                       Foreground="#CBD5E1"
                                       FontSize="11.5"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- STATE 2: COMPACT MEDIA PILL (Album Thumbnail + Smooth Lyric-Synced Pan + 5-Bar Waveform) -->
                    <Grid x:Name="CompactMediaPanel"
                          Margin="14,0,14,2"
                          Visibility="Collapsed"
                          ToolTip="Hover untuk buka • Klik Kanan untuk sembunyikan ke atas • Klik Tengah untuk Play/Pause">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Mini Album Cover -->
                        <Border Grid.Column="0"
                                Width="25" Height="25"
                                CornerRadius="7"
                                Background="#1E293B"
                                VerticalAlignment="Center"
                                ClipToBounds="True">
                            <Grid>
                                <TextBlock Text="♪"
                                           Foreground="#94A3B8"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <Image x:Name="CompactAlbumImage" Stretch="UniformToFill"/>
                            </Grid>
                        </Border>

                        <!-- Live Moving Lyrics Viewport (Smooth One-Way Pan mengikuti tempo lirik) -->
                        <Border x:Name="CompactLyricViewport"
                                Grid.Column="1"
                                Margin="11,0,11,0"
                                VerticalAlignment="Center"
                                ClipToBounds="True"
                                Height="24">
                            <Canvas VerticalAlignment="Center" Height="24" ClipToBounds="True">
                                <TextBlock x:Name="CompactSongTitleText"
                                           Canvas.Left="0"
                                           Canvas.Top="3"
                                           Text="♪ Memuat lirik lagu..."
                                           Foreground="#F8FAFC"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="CompactLyricTranslate" X="0" Y="0"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Canvas>
                        </Border>

                        <!-- 5-Bar Real-Time WASAPI Audio Spectrum -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Height="20">
                            <Rectangle x:Name="WaveBar0" Width="3.2" Height="6" RadiusX="1.6" RadiusY="1.6" Fill="#38BDF8" Margin="1.3,0" VerticalAlignment="Center"/>
                            <Rectangle x:Name="WaveBar1" Width="3.2" Height="12" RadiusX="1.6" RadiusY="1.6" Fill="#38BDF8" Margin="1.3,0" VerticalAlignment="Center"/>
                            <Rectangle x:Name="WaveBar2" Width="3.2" Height="16" RadiusX="1.6" RadiusY="1.6" Fill="#38BDF8" Margin="1.3,0" VerticalAlignment="Center"/>
                            <Rectangle x:Name="WaveBar3" Width="3.2" Height="10" RadiusX="1.6" RadiusY="1.6" Fill="#38BDF8" Margin="1.3,0" VerticalAlignment="Center"/>
                            <Rectangle x:Name="WaveBar4" Width="3.2" Height="5" RadiusX="1.6" RadiusY="1.6" Fill="#38BDF8" Margin="1.3,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- STATE 3: TOAST INTERRUPT PILL (Interactive Volume / Brightness Slider, Mic/Sound Mute, Bluetooth) -->
                    <Grid x:Name="ToastPanel"
                          Margin="18,0,18,2"
                          Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="ToastIconBadge"
                                Grid.Column="0"
                                Width="32" Height="32"
                                CornerRadius="10"
                                Background="#2438BDF8"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0">
                            <TextBlock x:Name="ToastIconText"
                                       Text="🔊"
                                       FontSize="15"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="ToastTitleText"
                                       Text="Volume 75%"
                                       Foreground="#F8FAFC"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ToastSubtitleText"
                                       Text="Scroll mouse atau geser slider"
                                       Foreground="#94A3B8"
                                       FontSize="10.5"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Interactive Toast Slider (Volume / Brightness) -->
                        <Grid x:Name="ToastProgressContainer"
                              Grid.Column="2"
                              Width="112"
                              Height="20"
                              Margin="14,0,2,0"
                              Background="Transparent"
                              Cursor="Hand"
                              VerticalAlignment="Center"
                              Visibility="Collapsed"
                              MouseLeftButtonDown="OnToastSliderMouseLeftButtonDown"
                              MouseMove="OnToastSliderMouseMove"
                              MouseLeftButtonUp="OnToastSliderMouseLeftButtonUp">
                            <Border x:Name="ToastProgressTrack"
                                    Width="112" Height="7"
                                    CornerRadius="3.5"
                                    Background="#28FFFFFF"
                                    VerticalAlignment="Center">
                                <Border x:Name="ToastProgressFill"
                                        HorizontalAlignment="Left"
                                        Width="65"
                                        Height="7"
                                        CornerRadius="3.5"
                                        Background="#38BDF8"/>
                            </Border>

                            <Ellipse x:Name="ToastSliderThumb"
                                     Width="13"
                                     Height="13"
                                     Fill="#FFFFFF"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="58,0,0,0"
                                     IsHitTestVisible="False">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#000000" Opacity="0.7"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                    </Grid>

                    <!-- STATE 4: EXPANDED DASHBOARD (NotchNook Unified Aesthetic) -->
                    <Grid x:Name="ExpandedDashboardPanel"
                          Margin="20,10,20,14"
                          Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Top Switcher Bar (NotchNook style pill tabs on left, clock & hide icon on right) -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="TabMediaBtn"
                                        Style="{StaticResource TabPillButtonStyle}"
                                        Content="🎵 Nook Musik"
                                        Click="OnTabMediaClick"/>
                                <Button x:Name="TabShelfBtn"
                                        Style="{StaticResource TabPillButtonStyle}"
                                        Content="📥 Tray File"
                                        Click="OnTabShelfClick"/>
                                <Button x:Name="TabPomodoroBtn"
                                        Style="{StaticResource TabPillButtonStyle}"
                                        Content="⏱️ Fokus"
                                        Click="OnTabPomodoroClick"/>
                                <Button x:Name="TabSystemBtn"
                                        Style="{StaticResource TabPillButtonStyle}"
                                        Content="⚙️ Sistem"
                                        Click="OnTabSystemClick"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock x:Name="ExpandedClockBadge"
                                           Text="14:25"
                                           Foreground="#64748B"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                <Button Style="{StaticResource IslandIconButtonStyle}"
                                        Padding="8,3"
                                        FontSize="10.5"
                                        Content="▲ Simpan"
                                        ToolTip="Lipat ke bibir atas layar agar tab/tombol aplikasi di belakangnya bisa diklik"
                                        Click="OnManualTuckClick"/>
                            </StackPanel>
                        </Grid>

                        <!-- TAB 0: MEDIA CONTROLLER + SEEKABLE TIMELINE + ANIMATED 3-LINE LYRICS STAGE -->
                        <Grid x:Name="MediaTabGrid" Grid.Row="1" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Album Art + Song Metadata + Transport Buttons -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="56" Height="56"
                                        CornerRadius="14"
                                        Background="#18181F"
                                        BorderBrush="#24FFFFFF"
                                        BorderThickness="1"
                                        ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="🎵"
                                                   FontSize="24"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        <Image x:Name="ExpandedAlbumImage" Stretch="UniformToFill"/>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="14,2,12,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="ExpandedSongTitleText"
                                               Text="Tidak Ada Media Aktif"
                                               Foreground="#F8FAFC"
                                               FontSize="14.5"
                                               FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="ExpandedArtistText"
                                               Text="Putar lagu di Spotify, Chrome, Edge, atau VLC"
                                               Foreground="#94A3B8"
                                               FontSize="12"
                                               Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IslandIconButtonStyle}"
                                            Width="32" Height="32"
                                            Margin="2,0"
                                            Content="⏮"
                                            ToolTip="Lagu Sebelumnya"
                                            Click="OnMediaPrevClick"/>
                                    <Button x:Name="PlayPauseButton"
                                            Style="{StaticResource IslandIconButtonStyle}"
                                            Width="36" Height="36"
                                            Margin="4,0"
                                            Content="▶"
                                            FontSize="13.5"
                                            ToolTip="Play / Pause (atau Klik Tengah)"
                                            Click="OnMediaPlayPauseClick"/>
                                    <Button Style="{StaticResource IslandIconButtonStyle}"
                                            Width="32" Height="32"
                                            Margin="2,0"
                                            Content="⏭"
                                            ToolTip="Lagu Berikutnya"
                                            Click="OnMediaNextClick"/>
                                </StackPanel>
                            </Grid>

                            <!-- Interactive Draggable Timeline Scrubber Bar -->
                            <Grid Grid.Row="1" Margin="0,9,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="ElapsedTimeText"
                                           Grid.Column="0"
                                           Text="0:00"
                                           Foreground="#94A3B8"
                                           FontSize="10.5"
                                           VerticalAlignment="Center"/>

                                <!-- Click & Drag Seek Hit Area -->
                                <Grid x:Name="TimelineScrubberHitArea"
                                      Grid.Column="1"
                                      Height="16"
                                      Margin="6,0"
                                      Background="Transparent"
                                      Cursor="Hand"
                                      ToolTip="Klik atau Geser (Drag) untuk mengubah posisi waktu lagu"
                                      MouseLeftButtonDown="OnTimelineMouseLeftButtonDown"
                                      MouseMove="OnTimelineMouseMove"
                                      MouseLeftButtonUp="OnTimelineMouseLeftButtonUp">
                                    <Border x:Name="TimelineTrackBorder"
                                            Height="6"
                                            CornerRadius="3"
                                            Background="#26FFFFFF"
                                            VerticalAlignment="Center">
                                        <Border x:Name="TimelineFillBorder"
                                                HorizontalAlignment="Left"
                                                Width="0"
                                                Height="6"
                                                CornerRadius="3"
                                                Background="#38BDF8"/>
                                    </Border>

                                    <!-- Scrubber Thumb Knob -->
                                    <Ellipse x:Name="TimelineThumb"
                                             Width="12"
                                             Height="12"
                                             Fill="#FFFFFF"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Center"
                                             Margin="-6,0,0,0"
                                             IsHitTestVisible="False">
                                        <Ellipse.Effect>
                                            <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#38BDF8" Opacity="0.9"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                </Grid>

                                <TextBlock x:Name="TotalDurationText"
                                           Grid.Column="2"
                                           Text="0:00"
                                           Foreground="#94A3B8"
                                           FontSize="10.5"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- ANIMATED 3-LINE LIVE LYRICS STAGE -->
                            <Border Grid.Row="2"
                                    Background="#10FFFFFF"
                                    BorderBrush="#1AFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="14,6"
                                    ClipToBounds="True">
                                <Grid>
                                    <Ellipse x:Name="LyricsStageGlowOrb"
                                             Width="200" Height="50"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Opacity="0.16"
                                             IsHitTestVisible="False">
                                        <Ellipse.Fill>
                                            <SolidColorBrush x:Name="LyricsStageOrbBrush" Color="#38BDF8"/>
                                        </Ellipse.Fill>
                                        <Ellipse.Effect>
                                            <BlurEffect Radius="28"/>
                                        </Ellipse.Effect>
                                    </Ellipse>

                                    <StackPanel x:Name="LyricsStageStack"
                                                VerticalAlignment="Center"
                                                RenderTransformOrigin="0.5,0.5">
                                        <StackPanel.RenderTransform>
                                            <TranslateTransform x:Name="LyricsStageTranslate" X="0" Y="0"/>
                                        </StackPanel.RenderTransform>

                                        <TextBlock x:Name="PrevLyricLineText"
                                                   Text=""
                                                   Foreground="#6694A3B8"
                                                   FontSize="11"
                                                   FontWeight="Medium"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,2"/>

                                        <TextBlock x:Name="CurrentLyricLineText"
                                                   Text="♪ Lirik otomatis muncul saat lagu diputar"
                                                   Foreground="#FFFFFF"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <ScaleTransform x:Name="ActiveLyricScale" ScaleX="1.0" ScaleY="1.0"/>
                                            </TextBlock.RenderTransform>
                                            <TextBlock.Effect>
                                                <DropShadowEffect x:Name="ActiveLyricGlowEffect"
                                                                  Color="#38BDF8"
                                                                  BlurRadius="12"
                                                                  ShadowDepth="0"
                                                                  Opacity="0.55"/>
                                            </TextBlock.Effect>
                                        </TextBlock>

                                        <Border x:Name="LyricLineProgressTrack"
                                                Width="120"
                                                Height="2.5"
                                                CornerRadius="1.25"
                                                Background="#22FFFFFF"
                                                HorizontalAlignment="Center"
                                                Margin="0,5,0,3">
                                            <Border x:Name="LyricLineProgressFill"
                                                    HorizontalAlignment="Left"
                                                    Width="0"
                                                    Height="2.5"
                                                    CornerRadius="1.25"
                                                    Background="#38BDF8"/>
                                        </Border>

                                        <TextBlock x:Name="NextLyricLineText"
                                                   Text="Mendukung sinkronisasi waktu real-time via LRCLIB"
                                                   Foreground="#99CBD5E1"
                                                   FontSize="11.5"
                                                   FontWeight="Medium"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- TAB 1: TEMPORARY FILE DROP SHELF (TRAY) -->
                        <Grid x:Name="ShelfTabGrid" Grid.Row="1" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock x:Name="ShelfHeaderCountText"
                                           Text="Taruh file/gambar sementara di sini (Drag Masuk &amp; Keluar)"
                                           Foreground="#94A3B8"
                                           FontSize="11.5"
                                           VerticalAlignment="Center"/>
                                <Button Style="{StaticResource IslandIconButtonStyle}"
                                        HorizontalAlignment="Right"
                                        Padding="8,3"
                                        FontSize="10.5"
                                        Content="Bersihkan"
                                        Click="OnClearShelfClick"/>
                            </Grid>

                            <Border Grid.Row="1"
                                    Background="#10FFFFFF"
                                    BorderBrush="#1EFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="8">
                                <Grid>
                                    <TextBlock x:Name="EmptyShelfHintText"
                                               Text="📥 Drag gambar atau file dari File Explorer / Browser ke Dynamic Island untuk disimpan sementara, lalu tarik keluar ke WhatsApp / Discord / aplikasi lain."
                                               Foreground="#64748B"
                                               FontSize="11.5"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="16,0"/>

                                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="ShelfItemsControl">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#20FFFFFF"
                                                            BorderBrush="#34FFFFFF"
                                                            BorderThickness="1"
                                                            CornerRadius="10"
                                                            Padding="8,6"
                                                            Margin="3"
                                                            Cursor="Hand"
                                                            MouseMove="OnShelfItemMouseMove">
                                                        <Border.ToolTip>
                                                            <ToolTip Background="#0F172A" BorderBrush="#334155" Padding="8">
                                                                <StackPanel>
                                                                    <Image Source="{Binding PreviewImage}"
                                                                           MaxWidth="180"
                                                                           MaxHeight="140"
                                                                           Stretch="Uniform"
                                                                           Margin="0,0,0,6"
                                                                           Visibility="{Binding PreviewImageVisibility}"/>
                                                                    <TextBlock Text="{Binding FileName}" Foreground="#F8FAFC" FontWeight="Bold" FontSize="11.5"/>
                                                                    <TextBlock Text="Tarik (Drag) keluar untuk mengirim file ini" Foreground="#94A3B8" FontSize="10"/>
                                                                </StackPanel>
                                                            </ToolTip>
                                                        </Border.ToolTip>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Width="40" Height="40"
                                                                    CornerRadius="8"
                                                                    Background="#1E293B"
                                                                    BorderBrush="#30FFFFFF"
                                                                    BorderThickness="1"
                                                                    Margin="0,0,8,0"
                                                                    ClipToBounds="True">
                                                                <Grid>
                                                                    <TextBlock Text="{Binding IconGlyph}"
                                                                               FontSize="18"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               Visibility="{Binding IconGlyphVisibility}"/>
                                                                    <Image Source="{Binding PreviewImage}"
                                                                           Stretch="UniformToFill"
                                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                                           Visibility="{Binding PreviewImageVisibility}"/>
                                                                </Grid>
                                                            </Border>

                                                            <StackPanel MaxWidth="130" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding FileName}"
                                                                           Foreground="#F8FAFC"
                                                                           FontSize="11.5"
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding SizeLabel}"
                                                                           Foreground="#94A3B8"
                                                                           FontSize="10"
                                                                           Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- TAB 2: POMODORO & FOCUS TIMER -->
                        <Grid x:Name="PomodoroTabGrid" Grid.Row="1" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="128" Height="106"
                                    Background="#12FFFFFF"
                                    BorderBrush="#22FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Margin="0,0,14,0">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="PomodoroModeLabel"
                                               Text="SESI FOKUS"
                                               Foreground="#38BDF8"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="PomodoroTimeText"
                                               Text="25:00"
                                               Foreground="#F8FAFC"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,2"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Kontrol Timer Produktivitas"
                                           Foreground="#CBD5E1"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>

                                <WrapPanel>
                                    <Button x:Name="PomodoroStartPauseBtn"
                                            Style="{StaticResource IslandIconButtonStyle}"
                                            Padding="14,7"
                                            Margin="0,0,6,6"
                                            Content="▶ Mulai"
                                            FontWeight="SemiBold"
                                            Click="OnPomodoroStartPauseClick"/>
                                    <Button Style="{StaticResource IslandIconButtonStyle}"
                                            Padding="11,7"
                                            Margin="0,0,6,6"
                                            Content="Fokus 25m"
                                            Click="OnPomodoroResetFocusClick"/>
                                    <Button Style="{StaticResource IslandIconButtonStyle}"
                                            Padding="11,7"
                                            Margin="0,0,6,6"
                                            Content="Break 5m"
                                            Click="OnPomodoroBreakClick"/>
                                    <Button Style="{StaticResource IslandIconButtonStyle}"
                                            Padding="11,7"
                                            Margin="0,0,6,6"
                                            Content="+5m"
                                            Click="OnPomodoroAdd5MinClick"/>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>

                        <!-- TAB 3: SYSTEM CONTROL CENTER (VOLUME SLIDER, BRIGHTNESS SLIDER, SOUND/MIC MUTE, TELEMETRY) -->
                        <Grid x:Name="SystemTabGrid" Grid.Row="1" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0: Interactive Volume & Brightness Sliders -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Volume Slider Card -->
                                <Border Grid.Column="0"
                                        Background="#14FFFFFF"
                                        BorderBrush="#22FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="12,8"
                                        Margin="0,0,5,0">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock x:Name="SysVolumeLabelText"
                                                       Text="🔊 VOLUME AUDIO"
                                                       Foreground="#CBD5E1"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SysVolumePercentText"
                                                       Text="65%"
                                                       Foreground="#38BDF8"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid x:Name="SysVolumeSliderHitArea"
                                              Height="16"
                                              Background="Transparent"
                                              Cursor="Hand"
                                              ToolTip="Klik atau Geser untuk mengatur Volume sistem"
                                              MouseLeftButtonDown="OnSysVolumeMouseDown"
                                              MouseMove="OnSysVolumeMouseMove"
                                              MouseLeftButtonUp="OnSysVolumeMouseUp">
                                            <Border x:Name="SysVolumeTrackBorder"
                                                    Height="6"
                                                    CornerRadius="3"
                                                    Background="#28FFFFFF"
                                                    VerticalAlignment="Center">
                                                <Border x:Name="SysVolumeFillBorder"
                                                        HorizontalAlignment="Left"
                                                        Width="110"
                                                        Height="6"
                                                        CornerRadius="3"
                                                        Background="#38BDF8"/>
                                            </Border>
                                            <Ellipse x:Name="SysVolumeThumb"
                                                     Width="12" Height="12"
                                                     Fill="#FFFFFF"
                                                     HorizontalAlignment="Left"
                                                     VerticalAlignment="Center"
                                                     Margin="104,0,0,0"
                                                     IsHitTestVisible="False"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Brightness Slider Card -->
                                <Border Grid.Column="1"
                                        Background="#14FFFFFF"
                                        BorderBrush="#22FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="12,8"
                                        Margin="5,0,0,0">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="☀️ KECERAHAN LAYAR"
                                                       Foreground="#CBD5E1"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SysBrightnessPercentText"
                                                       Text="20%"
                                                       Foreground="#FBBF24"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid x:Name="SysBrightnessSliderHitArea"
                                              Height="16"
                                              Background="Transparent"
                                              Cursor="Hand"
                                              ToolTip="Klik atau Geser untuk mengatur Kecerahan Layar (atau Shift + Scroll di pulau)"
                                              MouseLeftButtonDown="OnSysBrightnessMouseDown"
                                              MouseMove="OnSysBrightnessMouseMove"
                                              MouseLeftButtonUp="OnSysBrightnessMouseUp">
                                            <Border x:Name="SysBrightnessTrackBorder"
                                                    Height="6"
                                                    CornerRadius="3"
                                                    Background="#28FFFFFF"
                                                    VerticalAlignment="Center">
                                                <Border x:Name="SysBrightnessFillBorder"
                                                        HorizontalAlignment="Left"
                                                        Width="40"
                                                        Height="6"
                                                        CornerRadius="3"
                                                        Background="#FBBF24"/>
                                            </Border>
                                            <Ellipse x:Name="SysBrightnessThumb"
                                                     Width="12" Height="12"
                                                     Fill="#FFFFFF"
                                                     HorizontalAlignment="Left"
                                                     VerticalAlignment="Center"
                                                     Margin="34,0,0,0"
                                                     IsHitTestVisible="False"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Row 1: Telemetry Info Cards -->
                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="#12FFFFFF"
                                        CornerRadius="11"
                                        Padding="11,6"
                                        Margin="0,0,5,0">
                                    <StackPanel>
                                        <TextBlock x:Name="SysBatteryDetailText"
                                                   Text="⚡ 100% (AC Connected)"
                                                   Foreground="#F8FAFC"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="SysNetworkDetailText"
                                                   Text="Wi-Fi Terhubung"
                                                   Foreground="#94A3B8"
                                                   FontSize="10"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1"
                                        Background="#12FFFFFF"
                                        CornerRadius="11"
                                        Padding="11,6"
                                        Margin="5,0,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="SysPrivacyDetailText"
                                                   Text="🛡️ Kamera &amp; Mic Aman"
                                                   Foreground="#22C55E"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="SysMemoryDetailText"
                                                   Text="RAM Island: ~26 MB (0% Idle)"
                                                   Foreground="#94A3B8"
                                                   FontSize="10"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Row 2: Sound Mute, Mic Mute, Tuck & Exit Buttons -->
                            <WrapPanel Grid.Row="2" Orientation="Horizontal">
                                <Button x:Name="ToggleMuteBtn"
                                        Style="{StaticResource IslandIconButtonStyle}"
                                        Padding="11,6"
                                        Margin="0,0,6,0"
                                        FontSize="11"
                                        Content="🔊 Sound: ON"
                                        ToolTip="Mute / Unmute Suara Output Sistem"
                                        Click="OnToggleMuteClick"/>
                                <Button x:Name="ToggleMicMuteBtn"
                                        Style="{StaticResource IslandIconButtonStyle}"
                                        Padding="11,6"
                                        Margin="0,0,6,0"
                                        FontSize="11"
                                        Content="🎙️ Mic: ON"
                                        ToolTip="Mute / Unmute Mikrofon Secara Global"
                                        Click="OnToggleMicMuteClick"/>
                                <Button Style="{StaticResource IslandIconButtonStyle}"
                                        Padding="11,6"
                                        Margin="0,0,6,0"
                                        FontSize="11"
                                        Content="▲ Simpan"
                                        ToolTip="Lipat pulau ke bibir atas layar"
                                        Click="OnManualTuckClick"/>
                                <Button Style="{StaticResource IslandIconButtonStyle}"
                                        Padding="11,6"
                                        FontSize="11"
                                        Foreground="#F87171"
                                        Content="✖ Keluar"
                                        Click="OnExitAppClick"/>
                            </WrapPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
