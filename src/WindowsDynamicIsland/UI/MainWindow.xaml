<Window x:Class="WindowsDynamicIsland.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Dynamic Island"
        Icon="pack://application:,,,/Assets/app_icon.ico"
        Width="600"
        Height="310"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        AllowDrop="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid x:Name="RootCanvas"
          Background="{x:Null}"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Top">

        <!-- Soft Ambient Glow Behind the Unified Notch -->
        <Border x:Name="AmbientGlowBorder"
                Width="196"
                Height="36"
                CornerRadius="0,0,18,18"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,0,0,0"
                Opacity="0.0"
                IsHitTestVisible="False">
            <Border.Background>
                <SolidColorBrush x:Name="AmbientGlowBrush" Color="#38BDF8"/>
            </Border.Background>
            <Border.Effect>
                <BlurEffect Radius="24" KernelType="Gaussian"/>
            </Border.Effect>
        </Border>

        <!-- SINGLE UNIFIED NOTCHNOOK SILHOUETTE (Satu desain utuh menempel di atas layar) -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
            <!-- One-piece pure black NotchNook shape with top concave ears & bottom rounded corners -->
            <Path x:Name="UnifiedNotchPath"
                  Fill="#030305"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  IsHitTestVisible="False">
                <Path.Effect>
                    <DropShadowEffect x:Name="UnifiedNotchShadow" BlurRadius="22" ShadowDepth="5" Opacity="0.72" Color="#000000"/>
                </Path.Effect>
            </Path>

            <!-- Subtle contour rim along the sides and bottom only -->
            <Path x:Name="UnifiedNotchRimPath"
                  Stroke="#22FFFFFF"
                  StrokeThickness="1"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  IsHitTestVisible="False"/>

            <!-- Interactive Content Host -->
            <Border x:Name="IslandBorder"
                    Width="196"
                    Height="36"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,0,0,0"
                    Background="#01000000"
                    BorderThickness="0"
                    ClipToBounds="True"
                    MouseEnter="OnIslandMouseEnter"
                    MouseLeave="OnIslandMouseLeave"
                    MouseLeftButtonUp="OnIslandMouseLeftButtonUp"
                    MouseRightButtonUp="OnIslandMouseRightButtonUp"
                    MouseDown="OnIslandMouseDown"
                    MouseWheel="OnIslandMouseWheel"
                    DragEnter="OnIslandDragEnter"
                    DragOver="OnIslandDragOver"
                    Drop="OnIslandDrop">

                <Grid>
                    <!-- STATE 0: TUCKED TOP EDGE HANDLE ("Tersimpan di Atas") -->
                    <Grid x:Name="TuckedHandlePanel"
                          Visibility="Collapsed"
                          Cursor="Hand"
                          ToolTip="Dynamic Island tersimpan di atas (Klik untuk membuka)">
                        <Border x:Name="TuckedAccentBar"
                                Width="56"
                                Height="2.5"
                                CornerRadius="1.25"
                                Background="#38BDF8"
                                Opacity="0.90"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                    </Grid>

                    <!-- STATE 1: IDLE PILL (Clock + Privacy Dots + Vector Battery) -->
                    <Grid x:Name="IdlePillPanel"
                          Margin="16,0,16,2"
                          Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="IdlePulseDot"
                                     Width="6.5" Height="6.5"
                                     Fill="#38BDF8"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="ClockTextBlock"
                                       Text="14:25"
                                       Foreground="#F8FAFC"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Privacy Indicators (Camera = Green, Microphone = Orange) -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Ellipse x:Name="CameraPrivacyDot"
                                     Width="7.5" Height="7.5"
                                     Fill="#22C55E"
                                     Margin="3,0"
                                     ToolTip="Kamera sedang aktif"
                                     Visibility="Collapsed"/>
                            <Ellipse x:Name="MicPrivacyDot"
                                     Width="7.5" Height="7.5"
                                     Fill="#F97316"
                                     Margin="3,0"
                                     ToolTip="Mikrofon sedang aktif"
                                     Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- Vector Battery Graphic + Percentage Right Side -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,5,0">
                                <!-- Battery Body -->
                                <Border x:Name="IdleBatteryBodyBorder"
                                        Width="26" Height="13.5"
                                        CornerRadius="4"
                                        BorderThickness="1.3"
                                        BorderBrush="#75FFFFFF"
                                        Background="#1AFFFFFF"
                                        Padding="1.4"
                                        VerticalAlignment="Center">
                                    <Grid ClipToBounds="True">
                                        <Border x:Name="IdleBatteryFillBar"
                                                HorizontalAlignment="Left"
                                                Width="20"
                                                Height="8.5"
                                                CornerRadius="2.2"
                                                Background="#22C55E"/>
                                        <Path x:Name="IdleBatteryBoltPath"
                                              Data="{StaticResource GeomBolt}"
                                              Width="7.5" Height="9"
                                              Stretch="Uniform"
                                              Fill="#FFFFFF"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center">
                                            <Path.Effect>
                                                <DropShadowEffect BlurRadius="3" ShadowDepth="0" Color="#000000" Opacity="0.95"/>
                                            </Path.Effect>
                                        </Path>
                                    </Grid>
                                </Border>
                                <!-- Battery Positive Terminal Cap -->
                                <Border Width="2.2" Height="5.5"
                                        CornerRadius="0,1.5,1.5,0"
                                        Background="#75FFFFFF"
                                        Margin="1,0,0,0"
                                        VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="IdleBatteryPercentText"
                                       Text="100%"
                                       Foreground="#CBD5E1"
                                       FontSize="11.5"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- STATE 2: COMPACT MEDIA PILL (Album Thumbnail + Smooth Lyric-Synced Pan + 5-Bar True Audio Spectrum) -->
                    <Grid x:Name="CompactMediaPanel"
                          Margin="14,0,14,2"
                          Visibility="Collapsed"
                          ToolTip="Hover untuk buka • Klik Kanan untuk sembunyikan ke atas • Klik Tengah untuk Play/Pause">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Mini Album Cover -->
                        <Border Grid.Column="0"
                                Width="25" Height="25"
                                CornerRadius="7"
                                Background="#181822"
                                BorderBrush="#26FFFFFF"
                                BorderThickness="1"
                                VerticalAlignment="Center"
                                ClipToBounds="True">
                            <Grid>
                                <Path Data="{StaticResource GeomMusic}"
                                      Width="11" Height="11"
                                      Stretch="Uniform"
                                      Fill="#64748B"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                                <Image x:Name="CompactAlbumImage" Stretch="UniformToFill"/>
                            </Grid>
                        </Border>

                        <!-- Live Moving Lyrics Viewport -->
                        <Border x:Name="CompactLyricViewport"
                                Grid.Column="1"
                                Margin="11,0,11,0"
                                VerticalAlignment="Center"
                                ClipToBounds="True"
                                Height="24">
                            <Canvas VerticalAlignment="Center" Height="24" ClipToBounds="True">
                                <TextBlock x:Name="CompactSongTitleText"
                                           Canvas.Left="0"
                                           Canvas.Top="3"
                                           Text="Memuat lirik lagu..."
                                           Foreground="#F8FAFC"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="CompactLyricTranslate" X="0" Y="0"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Canvas>
                        </Border>

                        <!-- 5-Bar Real-Time WASAPI Loopback Audio Spectrum -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Height="20">
                            <Rectangle x:Name="WaveBar0" Width="3.2" Height="4" RadiusX="1.6" RadiusY="1.6" Fill="#38BDF8" Margin="1.3,0" VerticalAlignment="Center"/>
                            <Rectangle x:Name="WaveBar1" Width="3.2" Height="8" RadiusX="1.6" RadiusY="1.6" Fill="#38BDF8" Margin="1.3,0" VerticalAlignment="Center"/>
                            <Rectangle x:Name="WaveBar2" Width="3.2" Height="14" RadiusX="1.6" RadiusY="1.6" Fill="#38BDF8" Margin="1.3,0" VerticalAlignment="Center"/>
                            <Rectangle x:Name="WaveBar3" Width="3.2" Height="9" RadiusX="1.6" RadiusY="1.6" Fill="#38BDF8" Margin="1.3,0" VerticalAlignment="Center"/>
                            <Rectangle x:Name="WaveBar4" Width="3.2" Height="4" RadiusX="1.6" RadiusY="1.6" Fill="#38BDF8" Margin="1.3,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- STATE 3: TOAST INTERRUPT PILL (Bespoke Vector Badge + Interactive Volume / Brightness / Battery) -->
                    <Grid x:Name="ToastPanel"
                          Margin="18,0,18,2"
                          Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="ToastIconBadge"
                                Grid.Column="0"
                                Width="32" Height="32"
                                CornerRadius="10"
                                Background="#2438BDF8"
                                BorderBrush="#30FFFFFF"
                                BorderThickness="1"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0">
                            <Path x:Name="ToastIconPath"
                                  Data="{StaticResource GeomSpeakerOn}"
                                  Width="15" Height="15"
                                  Stretch="Uniform"
                                  Fill="#38BDF8"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="ToastTitleText"
                                       Text="Volume 75%"
                                       Foreground="#F8FAFC"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ToastSubtitleText"
                                       Text="Scroll mouse atau geser slider"
                                       Foreground="#94A3B8"
                                       FontSize="10.5"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Modern Line-Only Interactive Toast Slider (Volume / Brightness) -->
                        <Grid x:Name="ToastProgressContainer"
                              Grid.Column="2"
                              Width="112"
                              Height="20"
                              Margin="14,0,2,0"
                              Background="Transparent"
                              Cursor="Hand"
                              VerticalAlignment="Center"
                              Visibility="Collapsed"
                              MouseLeftButtonDown="OnToastSliderMouseLeftButtonDown"
                              MouseMove="OnToastSliderMouseMove"
                              MouseLeftButtonUp="OnToastSliderMouseLeftButtonUp">
                            <Border x:Name="ToastProgressTrack"
                                    Width="112" Height="8"
                                    CornerRadius="4"
                                    Background="#26FFFFFF"
                                    ClipToBounds="True"
                                    VerticalAlignment="Center">
                                <Border x:Name="ToastProgressFill"
                                        HorizontalAlignment="Left"
                                        Width="65"
                                        Height="8"
                                        CornerRadius="4"
                                        Background="#38BDF8"/>
                            </Border>
                        </Grid>

                        <!-- Dedicated Vector Battery Graphic for Charger Plug/Unplug Toast -->
                        <StackPanel x:Name="ToastBatteryContainer"
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="14,0,2,0"
                                    Visibility="Collapsed">
                            <Border x:Name="ToastBatteryBody"
                                    Width="54" Height="24"
                                    CornerRadius="6.5"
                                    BorderThickness="1.6"
                                    BorderBrush="#88FFFFFF"
                                    Background="#1EFFFFFF"
                                    Padding="2.2"
                                    VerticalAlignment="Center">
                                <Grid ClipToBounds="True">
                                    <Border x:Name="ToastBatteryFill"
                                            HorizontalAlignment="Left"
                                            Width="40"
                                            Height="16.5"
                                            CornerRadius="4"
                                            Background="#22C55E"/>

                                    <Path x:Name="ToastBatteryBoltPath"
                                          Data="{StaticResource GeomBolt}"
                                          Width="11" Height="13"
                                          Stretch="Uniform"
                                          Fill="#FFFFFF"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                                        <Path.Effect>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="#000000" Opacity="0.95"/>
                                        </Path.Effect>
                                    </Path>
                                </Grid>
                            </Border>

                            <Border x:Name="ToastBatteryCap"
                                    Width="3.5" Height="10"
                                    CornerRadius="0,2,2,0"
                                    Background="#88FFFFFF"
                                    Margin="1.5,0,0,0"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- STATE 4: EXPANDED DASHBOARD (Signature Cyber-Minimalist Vector UI) -->
                    <Grid x:Name="ExpandedDashboardPanel"
                          Margin="20,10,20,14"
                          Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Top Switcher Bar (Segmented Pill Control with Vector SVG Icons) -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="#12FFFFFF"
                                    BorderBrush="#1FFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="2.5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="TabMediaBtn"
                                            Style="{StaticResource TabPillButtonStyle}"
                                            Click="OnTabMediaClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource GeomMusic}"
                                                  Width="11.5" Height="11.5"
                                                  Stretch="Uniform"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Margin="0,0,5.5,0"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock Text="Musik" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="TabShelfBtn"
                                            Style="{StaticResource TabPillButtonStyle}"
                                            Click="OnTabShelfClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource GeomFolderTray}"
                                                  Width="11.5" Height="11.5"
                                                  Stretch="Uniform"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Margin="0,0,5.5,0"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock Text="Rak File" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="TabPomodoroBtn"
                                            Style="{StaticResource TabPillButtonStyle}"
                                            Click="OnTabPomodoroClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource GeomFocusTimer}"
                                                  Width="11.5" Height="11.5"
                                                  Stretch="Uniform"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Margin="0,0,5.5,0"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock Text="Fokus" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="TabSystemBtn"
                                            Style="{StaticResource TabPillButtonStyle}"
                                            Click="OnTabSystemClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource GeomSliders}"
                                                  Width="11.5" Height="11.5"
                                                  Stretch="Uniform"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Margin="0,0,5.5,0"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock Text="Sistem" VerticalAlignment="Center"/>
                                            <Ellipse x:Name="TabSystemUpdateBadge"
                                                     Width="5.5" Height="5.5"
                                                     Fill="#22C55E"
                                                     Margin="4.5,0,0,0"
                                                     VerticalAlignment="Center"
                                                     Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock x:Name="ExpandedClockBadge"
                                           Text="14:25"
                                           Foreground="#64748B"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                <Button Style="{StaticResource IslandIconButtonStyle}"
                                        Padding="9,4"
                                        ToolTip="Lipat ke bibir atas layar agar tab/tombol aplikasi di belakangnya bisa diklik"
                                        Click="OnManualTuckClick">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeomChevronUp}"
                                              Width="10" Height="10"
                                              Stretch="Uniform"
                                              Fill="#CBD5E1"
                                              Margin="0,0,4,0"
                                              VerticalAlignment="Center"/>
                                        <TextBlock Text="Simpan" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- TAB 0: MEDIA CONTROLLER + MODERN TIMELINE + FLOATING LYRICS STAGE -->
                        <Grid x:Name="MediaTabGrid" Grid.Row="1" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Album Art + Song Metadata + Bespoke Vector Transport Buttons -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Modern Glowing Album Art -->
                                <Border Grid.Column="0"
                                        Width="58" Height="58"
                                        CornerRadius="14"
                                        Background="#14141D"
                                        BorderBrush="#28FFFFFF"
                                        BorderThickness="1"
                                        ClipToBounds="True">
                                    <Border.Effect>
                                        <DropShadowEffect x:Name="AlbumShadowEffect" BlurRadius="16" ShadowDepth="2" Opacity="0.5" Color="#38BDF8"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Path Data="{StaticResource GeomMusic}"
                                              Width="22" Height="22"
                                              Stretch="Uniform"
                                              Fill="#475569"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                        <Image x:Name="ExpandedAlbumImage" Stretch="UniformToFill"/>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="14,1,12,0" VerticalAlignment="Center">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ExpandedSongTitleText"
                                                   Grid.Column="0"
                                                   Text="Tidak Ada Media Aktif"
                                                   Foreground="#F8FAFC"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>

                                        <!-- Live 5-Bar Song Spectrum in Expanded Mode -->
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Height="16"
                                                    Margin="8,0,4,0">
                                            <Rectangle x:Name="ExpWaveBar0" Width="2.8" Height="4" RadiusX="1.4" RadiusY="1.4" Fill="#38BDF8" Margin="1.1,0" VerticalAlignment="Center"/>
                                            <Rectangle x:Name="ExpWaveBar1" Width="2.8" Height="7" RadiusX="1.4" RadiusY="1.4" Fill="#38BDF8" Margin="1.1,0" VerticalAlignment="Center"/>
                                            <Rectangle x:Name="ExpWaveBar2" Width="2.8" Height="11" RadiusX="1.4" RadiusY="1.4" Fill="#38BDF8" Margin="1.1,0" VerticalAlignment="Center"/>
                                            <Rectangle x:Name="ExpWaveBar3" Width="2.8" Height="7" RadiusX="1.4" RadiusY="1.4" Fill="#38BDF8" Margin="1.1,0" VerticalAlignment="Center"/>
                                            <Rectangle x:Name="ExpWaveBar4" Width="2.8" Height="4" RadiusX="1.4" RadiusY="1.4" Fill="#38BDF8" Margin="1.1,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <!-- Real-time Active Audio Destination Pill (Vector Icon + Clean Device Name) -->
                                        <Border x:Name="AudioDeviceBadge"
                                                Background="#2438BDF8"
                                                BorderBrush="#2E38BDF8"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="6,2"
                                                Margin="0,0,7,0"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path x:Name="AudioDeviceIconPath"
                                                      Data="{StaticResource GeomSpeakerOn}"
                                                      Width="10" Height="10"
                                                      Stretch="Uniform"
                                                      Fill="#38BDF8"
                                                      Margin="0,0,4.5,0"
                                                      VerticalAlignment="Center"/>
                                                <TextBlock x:Name="AudioDeviceBadgeText"
                                                           Text="Speaker"
                                                           Foreground="#38BDF8"
                                                           FontSize="9.5"
                                                           FontWeight="SemiBold"
                                                           MaxWidth="115"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock x:Name="ExpandedArtistText"
                                                   Text="Putar lagu di Spotify, Chrome, Edge, atau VLC"
                                                   Foreground="#94A3B8"
                                                   FontSize="12"
                                                   MaxWidth="215"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Bespoke Vector Transport Buttons (Zero Emoji Boxes!) -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IslandCircularButtonStyle}"
                                            ToolTip="Lagu Sebelumnya"
                                            Click="OnMediaPrevClick">
                                        <Path Data="{StaticResource GeomSkipPrev}"
                                              Width="12" Height="12"
                                              Stretch="Uniform"
                                              Fill="#F8FAFC"/>
                                    </Button>

                                    <Button x:Name="PlayPauseButton"
                                            Style="{StaticResource PlayPauseHeroButtonStyle}"
                                            Margin="6,0"
                                            ToolTip="Play / Pause (atau Klik Tengah)"
                                            Click="OnMediaPlayPauseClick">
                                        <Path x:Name="PlayPauseIconPath"
                                              Data="{StaticResource GeomPlay}"
                                              Width="13.5" Height="13.5"
                                              Stretch="Uniform"
                                              Fill="#09090B"/>
                                    </Button>

                                    <Button Style="{StaticResource IslandCircularButtonStyle}"
                                            ToolTip="Lagu Berikutnya"
                                            Click="OnMediaNextClick">
                                        <Path Data="{StaticResource GeomSkipNext}"
                                              Width="12" Height="12"
                                              Stretch="Uniform"
                                              Fill="#F8FAFC"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Interactive Draggable Timeline Scrubber Bar (Modern Line-Only) -->
                            <Grid Grid.Row="1" Margin="0,10,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="38"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="ElapsedTimeText"
                                           Grid.Column="0"
                                           Text="0:00"
                                           Foreground="#94A3B8"
                                           FontSize="11"
                                           FontWeight="Medium"
                                           FontFamily="Segoe UI Variable Text, Consolas, Segoe UI"
                                           VerticalAlignment="Center"/>

                                <!-- Click & Drag Seek Hit Area -->
                                <Grid x:Name="TimelineScrubberHitArea"
                                      Grid.Column="1"
                                      Height="16"
                                      Margin="6,0"
                                      Background="Transparent"
                                      Cursor="Hand"
                                      ToolTip="Klik atau Geser (Drag) untuk mengubah posisi waktu lagu"
                                      MouseLeftButtonDown="OnTimelineMouseLeftButtonDown"
                                      MouseMove="OnTimelineMouseMove"
                                      MouseLeftButtonUp="OnTimelineMouseLeftButtonUp">
                                    <Border x:Name="TimelineTrackBorder"
                                            Height="6"
                                            CornerRadius="3"
                                            Background="#24FFFFFF"
                                            ClipToBounds="True"
                                            VerticalAlignment="Center">
                                        <Border x:Name="TimelineFillBorder"
                                                HorizontalAlignment="Left"
                                                Width="0"
                                                Height="6"
                                                CornerRadius="3"
                                                Background="#38BDF8"/>
                                    </Border>
                                </Grid>

                                <TextBlock x:Name="TotalDurationText"
                                           Grid.Column="2"
                                           Text="0:00"
                                           Foreground="#94A3B8"
                                           FontSize="11"
                                           FontWeight="Medium"
                                           FontFamily="Segoe UI Variable Text, Consolas, Segoe UI"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- ANIMATED 3-LINE LIVE LYRICS STAGE -->
                            <Border Grid.Row="2"
                                    Background="#0CFFFFFF"
                                    BorderBrush="#16FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="14,6"
                                    ClipToBounds="True">
                                <Grid>
                                    <Ellipse x:Name="LyricsStageGlowOrb"
                                             Width="220" Height="50"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Opacity="0.16"
                                             IsHitTestVisible="False">
                                        <Ellipse.Fill>
                                            <SolidColorBrush x:Name="LyricsStageOrbBrush" Color="#38BDF8"/>
                                        </Ellipse.Fill>
                                        <Ellipse.Effect>
                                            <BlurEffect Radius="28"/>
                                        </Ellipse.Effect>
                                    </Ellipse>

                                    <StackPanel x:Name="LyricsStageStack"
                                                VerticalAlignment="Center"
                                                RenderTransformOrigin="0.5,0.5">
                                        <StackPanel.RenderTransform>
                                            <TranslateTransform x:Name="LyricsStageTranslate" X="0" Y="0"/>
                                        </StackPanel.RenderTransform>

                                        <TextBlock x:Name="PrevLyricLineText"
                                                   Text=""
                                                   Foreground="#5594A3B8"
                                                   FontSize="11.5"
                                                   FontWeight="Medium"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,2"/>

                                        <TextBlock x:Name="CurrentLyricLineText"
                                                   Text="Lirik otomatis muncul saat lagu diputar"
                                                   Foreground="#FFFFFF"
                                                   FontSize="14.5"
                                                   FontWeight="Bold"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <ScaleTransform x:Name="ActiveLyricScale" ScaleX="1.0" ScaleY="1.0"/>
                                            </TextBlock.RenderTransform>
                                            <TextBlock.Effect>
                                                <DropShadowEffect x:Name="ActiveLyricGlowEffect"
                                                                  Color="#38BDF8"
                                                                  BlurRadius="12"
                                                                  ShadowDepth="0"
                                                                  Opacity="0.55"/>
                                            </TextBlock.Effect>
                                        </TextBlock>

                                        <Border x:Name="LyricLineProgressTrack"
                                                Width="120"
                                                Height="2.5"
                                                CornerRadius="1.25"
                                                Background="#22FFFFFF"
                                                HorizontalAlignment="Center"
                                                Margin="0,5,0,3">
                                            <Border x:Name="LyricLineProgressFill"
                                                    HorizontalAlignment="Left"
                                                    Width="0"
                                                    Height="2.5"
                                                    CornerRadius="1.25"
                                                    Background="#38BDF8"/>
                                        </Border>

                                        <TextBlock x:Name="NextLyricLineText"
                                                   Text="Sinkronisasi waktu real-time via LRCLIB"
                                                   Foreground="#99CBD5E1"
                                                   FontSize="11.5"
                                                   FontWeight="Medium"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- TAB 1: TEMPORARY FILE DROP SHELF (TRAY) -->
                        <Grid x:Name="ShelfTabGrid" Grid.Row="1" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource GeomFolderTray}"
                                          Width="12" Height="12"
                                          Stretch="Uniform"
                                          Fill="#38BDF8"
                                          Margin="0,0,6,0"
                                          VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ShelfHeaderCountText"
                                               Text="Taruh file/gambar sementara di sini (Drag Masuk &amp; Keluar)"
                                               Foreground="#94A3B8"
                                               FontSize="11.5"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Style="{StaticResource IslandIconButtonStyle}"
                                        HorizontalAlignment="Right"
                                        Padding="8,3"
                                        FontSize="10.5"
                                        Content="Bersihkan"
                                        Click="OnClearShelfClick"/>
                            </Grid>

                            <Border Grid.Row="1"
                                    Background="#10FFFFFF"
                                    BorderBrush="#1EFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="8">
                                <Grid>
                                    <StackPanel x:Name="EmptyShelfHintPanel"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                Margin="16,0">
                                        <Path Data="{StaticResource GeomFolderTray}"
                                              Width="22" Height="22"
                                              Stretch="Uniform"
                                              Fill="#475569"
                                              HorizontalAlignment="Center"
                                              Margin="0,0,0,6"/>
                                        <TextBlock Text="Drag gambar atau file dari File Explorer / Browser ke Dynamic Island untuk disimpan sementara, lalu tarik keluar ke WhatsApp / Discord / aplikasi lain."
                                                   Foreground="#64748B"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"/>
                                    </StackPanel>

                                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="ShelfItemsControl">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#20FFFFFF"
                                                            BorderBrush="#34FFFFFF"
                                                            BorderThickness="1"
                                                            CornerRadius="10"
                                                            Padding="8,6"
                                                            Margin="3"
                                                            Cursor="Hand"
                                                            MouseMove="OnShelfItemMouseMove">
                                                        <Border.ToolTip>
                                                            <ToolTip Background="#0F172A" BorderBrush="#334155" Padding="8">
                                                                <StackPanel>
                                                                    <Image Source="{Binding PreviewImage}"
                                                                           MaxWidth="180"
                                                                           MaxHeight="140"
                                                                           Stretch="Uniform"
                                                                           Margin="0,0,0,6"
                                                                           Visibility="{Binding PreviewImageVisibility}"/>
                                                                    <TextBlock Text="{Binding FileName}" Foreground="#F8FAFC" FontWeight="Bold" FontSize="11.5"/>
                                                                    <TextBlock Text="Tarik (Drag) keluar untuk mengirim file ini" Foreground="#94A3B8" FontSize="10"/>
                                                                </StackPanel>
                                                            </ToolTip>
                                                        </Border.ToolTip>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Width="40" Height="40"
                                                                    CornerRadius="8"
                                                                    Background="#1E293B"
                                                                    BorderBrush="#30FFFFFF"
                                                                    BorderThickness="1"
                                                                    Margin="0,0,8,0"
                                                                    ClipToBounds="True">
                                                                <Grid>
                                                                    <TextBlock Text="{Binding IconGlyph}"
                                                                               FontSize="10"
                                                                               FontWeight="Bold"
                                                                               Foreground="#38BDF8"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               Visibility="{Binding IconGlyphVisibility}"/>
                                                                    <Image Source="{Binding PreviewImage}"
                                                                           Stretch="UniformToFill"
                                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                                           Visibility="{Binding PreviewImageVisibility}"/>
                                                                </Grid>
                                                            </Border>

                                                            <StackPanel MaxWidth="130" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding FileName}"
                                                                           Foreground="#F8FAFC"
                                                                           FontSize="11.5"
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding SizeLabel}"
                                                                           Foreground="#94A3B8"
                                                                           FontSize="10"
                                                                           Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- TAB 2: POMODORO & FOCUS TIMER -->
                        <Grid x:Name="PomodoroTabGrid" Grid.Row="1" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="128" Height="106"
                                    Background="#12FFFFFF"
                                    BorderBrush="#22FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Margin="0,0,14,0">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="PomodoroModeLabel"
                                               Text="SESI FOKUS"
                                               Foreground="#38BDF8"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="PomodoroTimeText"
                                               Text="25:00"
                                               Foreground="#F8FAFC"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,2"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Kontrol Timer Produktivitas"
                                           Foreground="#CBD5E1"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>

                                <WrapPanel>
                                    <Button x:Name="PomodoroStartPauseBtn"
                                            Style="{StaticResource IslandIconButtonStyle}"
                                            Padding="14,7"
                                            Margin="0,0,6,6"
                                            Click="OnPomodoroStartPauseClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Path x:Name="PomodoroPlayPauseIconPath"
                                                  Data="{StaticResource GeomPlay}"
                                                  Width="10" Height="10"
                                                  Stretch="Uniform"
                                                  Fill="#38BDF8"
                                                  Margin="0,0,5,0"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock x:Name="PomodoroStartPauseText"
                                                       Text="Mulai"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource IslandIconButtonStyle}"
                                            Padding="11,7"
                                            Margin="0,0,6,6"
                                            Content="Fokus 25m"
                                            Click="OnPomodoroResetFocusClick"/>
                                    <Button Style="{StaticResource IslandIconButtonStyle}"
                                            Padding="11,7"
                                            Margin="0,0,6,6"
                                            Content="Break 5m"
                                            Click="OnPomodoroBreakClick"/>
                                    <Button Style="{StaticResource IslandIconButtonStyle}"
                                            Padding="11,7"
                                            Margin="0,0,6,6"
                                            Content="+5m"
                                            Click="OnPomodoroAdd5MinClick"/>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>

                        <!-- TAB 3: SYSTEM CONTROL CENTER (VOLUME SLIDER, BRIGHTNESS SLIDER, SOUND/MIC MUTE, TELEMETRY, UPDATE) -->
                        <Grid x:Name="SystemTabGrid" Grid.Row="1" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0: Interactive Volume & Brightness Sliders (Overlap-Free 2-Column Headers!) -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Volume Slider Card -->
                                <Border Grid.Column="0"
                                        Background="#14FFFFFF"
                                        BorderBrush="#22FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="12,8"
                                        Margin="0,0,5,0">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Path x:Name="SysVolumeHeaderIconPath"
                                                  Grid.Column="0"
                                                  Data="{StaticResource GeomSpeakerOn}"
                                                  Width="11" Height="11"
                                                  Stretch="Uniform"
                                                  Fill="#38BDF8"
                                                  Margin="0,0,5,0"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SysVolumeLabelText"
                                                       Grid.Column="1"
                                                       Text="VOLUME AUDIO"
                                                       Foreground="#CBD5E1"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Margin="0,0,6,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SysVolumePercentText"
                                                       Grid.Column="2"
                                                       Text="65%"
                                                       Foreground="#38BDF8"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid x:Name="SysVolumeSliderHitArea"
                                              Height="16"
                                              Background="Transparent"
                                              Cursor="Hand"
                                              ToolTip="Klik atau Geser untuk mengatur Volume sistem"
                                              MouseLeftButtonDown="OnSysVolumeMouseDown"
                                              MouseMove="OnSysVolumeMouseMove"
                                              MouseLeftButtonUp="OnSysVolumeMouseUp">
                                            <Border x:Name="SysVolumeTrackBorder"
                                                    Height="8"
                                                    CornerRadius="4"
                                                    Background="#28FFFFFF"
                                                    ClipToBounds="True"
                                                    VerticalAlignment="Center">
                                                <Border x:Name="SysVolumeFillBorder"
                                                        HorizontalAlignment="Left"
                                                        Width="110"
                                                        Height="8"
                                                        CornerRadius="4"
                                                        Background="#38BDF8"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Brightness Slider Card -->
                                <Border Grid.Column="1"
                                        Background="#14FFFFFF"
                                        BorderBrush="#22FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="12,8"
                                        Margin="5,0,0,0">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0"
                                                  Data="{StaticResource GeomBrightnessSun}"
                                                  Width="11" Height="11"
                                                  Stretch="Uniform"
                                                  Fill="#FBBF24"
                                                  Margin="0,0,5,0"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="KECERAHAN LAYAR"
                                                       Foreground="#CBD5E1"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Margin="0,0,6,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SysBrightnessPercentText"
                                                       Grid.Column="2"
                                                       Text="20%"
                                                       Foreground="#FBBF24"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid x:Name="SysBrightnessSliderHitArea"
                                              Height="16"
                                              Background="Transparent"
                                              Cursor="Hand"
                                              ToolTip="Klik atau Geser untuk mengatur Kecerahan Layar (atau Shift + Scroll di pulau)"
                                              MouseLeftButtonDown="OnSysBrightnessMouseDown"
                                              MouseMove="OnSysBrightnessMouseMove"
                                              MouseLeftButtonUp="OnSysBrightnessMouseUp">
                                            <Border x:Name="SysBrightnessTrackBorder"
                                                    Height="8"
                                                    CornerRadius="4"
                                                    Background="#28FFFFFF"
                                                    ClipToBounds="True"
                                                    VerticalAlignment="Center">
                                                <Border x:Name="SysBrightnessFillBorder"
                                                        HorizontalAlignment="Left"
                                                        Width="40"
                                                        Height="8"
                                                        CornerRadius="4"
                                                        Background="#FBBF24"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Row 1: Telemetry Info Cards with Vector Icons -->
                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="#12FFFFFF"
                                        CornerRadius="11"
                                        Padding="11,6"
                                        Margin="0,0,5,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource GeomBolt}"
                                                  Width="10" Height="11"
                                                  Stretch="Uniform"
                                                  Fill="#22C55E"
                                                  Margin="0,0,5,0"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SysBatteryDetailText"
                                                       Text="100% (AC Connected)"
                                                       Foreground="#F8FAFC"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="SysNetworkDetailText"
                                                   Text="Wi-Fi Terhubung"
                                                   Foreground="#94A3B8"
                                                   FontSize="10"
                                                   Margin="0,1,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1"
                                        Background="#12FFFFFF"
                                        CornerRadius="11"
                                        Padding="11,6"
                                        Margin="5,0,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Path x:Name="SysPrivacyIconPath"
                                                  Data="{StaticResource GeomShield}"
                                                  Width="10.5" Height="11"
                                                  Stretch="Uniform"
                                                  Fill="#22C55E"
                                                  Margin="0,0,5,0"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SysPrivacyDetailText"
                                                       Text="Kamera &amp; Mic Aman"
                                                       Foreground="#22C55E"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="SysMemoryDetailText"
                                                   Text="RAM Island: ~26 MB (0% Idle)"
                                                   Foreground="#94A3B8"
                                                   FontSize="10"
                                                   Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Row 2: Software Update & Release Notification Card -->
                            <Border Grid.Row="2"
                                    x:Name="SysUpdateCardBorder"
                                    Background="#12FFFFFF"
                                    BorderBrush="#20FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="11"
                                    Padding="10,6"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Path x:Name="SysUpdateIconPath"
                                          Grid.Column="0"
                                          Data="{StaticResource GeomShield}"
                                          Width="12.5" Height="12.5"
                                          Stretch="Uniform"
                                          Fill="#22C55E"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="SysUpdateStatusText"
                                                   Text="Windows Dynamic Island v1.1.1 (Terbaru)"
                                                   Foreground="#F8FAFC"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="SysUpdateSubText"
                                                   Text="Sistem terpasang versi paling mutakhir"
                                                   Foreground="#94A3B8"
                                                   FontSize="9.5"
                                                   Margin="0,1,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="SysCheckUpdateBtn"
                                                Style="{StaticResource IslandIconButtonStyle}"
                                                Padding="8,4"
                                                Margin="4,0,0,0"
                                                ToolTip="Periksa pembaruan rilis terbaru di GitHub"
                                                Click="OnCheckUpdateClick">
                                            <StackPanel Orientation="Horizontal">
                                                <Path x:Name="SysCheckUpdateIcon"
                                                      Data="{StaticResource GeomRefresh}"
                                                      Width="9.5" Height="9.5"
                                                      Stretch="Uniform"
                                                      Fill="#38BDF8"
                                                      Margin="0,0,4,0"
                                                      VerticalAlignment="Center"/>
                                                <TextBlock x:Name="SysCheckUpdateBtnText"
                                                           Text="Cek Update"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="SysInstallUpdateBtn"
                                                Style="{StaticResource IslandIconButtonStyle}"
                                                Background="#222C5E"
                                                BorderBrush="#22C55E"
                                                Padding="8,4"
                                                Margin="5,0,0,0"
                                                Visibility="Collapsed"
                                                ToolTip="Unduh dan pasang pembaruan versi terbaru sekarang"
                                                Click="OnInstallUpdateClick">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource GeomUpdate}"
                                                      Width="10" Height="10"
                                                      Stretch="Uniform"
                                                      Fill="#22C55E"
                                                      Margin="0,0,4,0"
                                                      VerticalAlignment="Center"/>
                                                <TextBlock Text="Update Sekarang"
                                                           Foreground="#22C55E"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Row 3: Sound Mute, Mic Mute, Tuck & Exit Buttons with Bespoke Vector Icons -->
                            <WrapPanel Grid.Row="3" Orientation="Horizontal">
                                <Button x:Name="ToggleMuteBtn"
                                        Style="{StaticResource IslandIconButtonStyle}"
                                        Padding="11,6"
                                        Margin="0,0,6,0"
                                        ToolTip="Mute / Unmute Suara Output Sistem"
                                        Click="OnToggleMuteClick">
                                    <StackPanel Orientation="Horizontal">
                                        <Path x:Name="ToggleMuteIconPath"
                                              Data="{StaticResource GeomSpeakerOn}"
                                              Width="11.5" Height="11.5"
                                              Stretch="Uniform"
                                              Fill="#38BDF8"
                                              Margin="0,0,5.5,0"
                                              VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ToggleMuteText"
                                                   Text="Sound: ON"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="ToggleMicMuteBtn"
                                        Style="{StaticResource IslandIconButtonStyle}"
                                        Padding="11,6"
                                        Margin="0,0,6,0"
                                        ToolTip="Mute / Unmute Mikrofon Secara Global"
                                        Click="OnToggleMicMuteClick">
                                    <StackPanel Orientation="Horizontal">
                                        <Path x:Name="ToggleMicIconPath"
                                              Data="{StaticResource GeomMicOn}"
                                              Width="11.5" Height="11.5"
                                              Stretch="Uniform"
                                              Fill="#22C55E"
                                              Margin="0,0,5.5,0"
                                              VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ToggleMicText"
                                                   Text="Mic: ON"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource IslandIconButtonStyle}"
                                        Padding="11,6"
                                        Margin="0,0,6,0"
                                        ToolTip="Lipat pulau ke bibir atas layar"
                                        Click="OnManualTuckClick">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeomChevronUp}"
                                              Width="10.5" Height="10.5"
                                              Stretch="Uniform"
                                              Fill="#CBD5E1"
                                              Margin="0,0,4.5,0"
                                              VerticalAlignment="Center"/>
                                        <TextBlock Text="Simpan"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource IslandIconButtonStyle}"
                                        Padding="11,6"
                                        Margin="0,0,6,0"
                                        ToolTip="Buka file log error dan diagnostik lengkap"
                                        Click="OnOpenLogClick">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeomTerminalLog}"
                                              Width="10.5" Height="10.5"
                                              Stretch="Uniform"
                                              Fill="#38BDF8"
                                              Margin="0,0,4.5,0"
                                              VerticalAlignment="Center"/>
                                        <TextBlock Text="Log"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource IslandIconButtonStyle}"
                                        Padding="11,6"
                                        Click="OnExitAppClick">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeomClosePower}"
                                              Width="10.5" Height="10.5"
                                              Stretch="Uniform"
                                              Fill="#F87171"
                                              Margin="0,0,4.5,0"
                                              VerticalAlignment="Center"/>
                                        <TextBlock Text="Keluar"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F87171"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
