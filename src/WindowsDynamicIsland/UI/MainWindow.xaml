<Window x:Class="WindowsDynamicIsland.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Dynamic Island"
        Icon="pack://application:,,,/Assets/app_icon.ico"
        Width="760"
        Height="310"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        AllowDrop="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid x:Name="RootCanvas"
          Background="{x:Null}"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Top"
          MouseMove="OnRootCanvasMouseMove">

        <!-- UNIFIED NOTCH MASTER CONTAINER (Single Continuous Mesh, Zero Gaps, 760px Wide) -->
        <Grid x:Name="UnifiedMasterGrid" HorizontalAlignment="Left" VerticalAlignment="Top" Width="760" Height="310">

            <!-- Soft Ambient Glow Behind the Unified Notch (Dynamically sized and positioned) -->
            <Border x:Name="AmbientGlowBorder"
                    Width="196"
                    Height="36"
                    CornerRadius="0,0,18,18"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="282,0,0,0"
                    Opacity="0.0"
                    IsHitTestVisible="False">
                <Border.Background>
                    <SolidColorBrush x:Name="AmbientGlowBrush" Color="#38BDF8"/>
                </Border.Background>
                <Border.Effect>
                    <BlurEffect Radius="24" KernelType="Gaussian"/>
                </Border.Effect>
            </Border>

            <!-- SINGLE UNIFIED NOTCH SILHOUETTE (Satu desain utuh menempel di atas layar, meregang organik) -->
            <Path x:Name="UnifiedNotchPath"
                  Fill="#030305"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  IsHitTestVisible="False">
                <Path.Effect>
                    <DropShadowEffect x:Name="UnifiedNotchShadow" BlurRadius="22" ShadowDepth="5" Opacity="0.72" Color="#000000"/>
                </Path.Effect>
            </Path>

            <!-- Subtle contour rim along the sides and bottom of the unified shape -->
            <Path x:Name="UnifiedNotchRimPath"
                  Stroke="#22FFFFFF"
                  StrokeThickness="1"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  IsHitTestVisible="False"/>

            <!-- LEFT INTEGRATED WING CONTENT (Transparent inside unified silhouette, X = 34) -->
            <Grid x:Name="LeftWingContainer"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Margin="34,52,0,0"
                  Width="76"
                  Height="140"
                  Opacity="0.0"
                  Visibility="Collapsed"
                  IsHitTestVisible="False">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="LeftWingTranslate" X="0" Y="0"/>
                </Grid.RenderTransform>
                <Button x:Name="LeftWingBtn"
                        Style="{StaticResource WingPillButtonStyle}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Click="OnLeftWingClick">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="{StaticResource GeomChevronLeft}"
                              Width="11" Height="11"
                              Stretch="Uniform"
                              Fill="#38BDF8"
                              Margin="0,0,0,6"
                              HorizontalAlignment="Center"/>
                        <Border Width="36" Height="36" CornerRadius="18" Background="#1E38BDF8" BorderBrush="#3538BDF8" BorderThickness="1" Margin="0,0,0,6">
                            <Path x:Name="LeftWingIcon"
                                  Data="{StaticResource GeomMusic}"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  Fill="#F8FAFC"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="LeftWingLabel"
                                   Text="Musik"
                                   Foreground="#CBD5E1"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- RIGHT INTEGRATED WING CONTENT (Transparent inside unified silhouette, X = 650) -->
            <Grid x:Name="RightWingContainer"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Margin="650,52,0,0"
                  Width="76"
                  Height="140"
                  Opacity="0.0"
                  Visibility="Collapsed"
                  IsHitTestVisible="False">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="RightWingTranslate" X="0" Y="0"/>
                </Grid.RenderTransform>
                <Button x:Name="RightWingBtn"
                        Style="{StaticResource WingPillButtonStyle}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Click="OnRightWingClick">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="{StaticResource GeomChevronRight}"
                              Width="11" Height="11"
                              Stretch="Uniform"
                              Fill="#38BDF8"
                              Margin="0,0,0,6"
                              HorizontalAlignment="Center"/>
                        <Border Width="36" Height="36" CornerRadius="18" Background="#1E38BDF8" BorderBrush="#3538BDF8" BorderThickness="1" Margin="0,0,0,6">
                            <Path x:Name="RightWingIcon"
                                  Data="{StaticResource GeomChecklist}"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  Fill="#F8FAFC"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="RightWingLabel"
                                   Text="Tugas"
                                   Foreground="#CBD5E1"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Interactive Main Content Host (Positioned dynamically at contentLeft, Width="bodyWidth") -->
            <Border x:Name="IslandBorder"
                    Width="196"
                    Height="36"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="282,0,0,0"
                    Background="#01000000"
                    BorderThickness="0"
                    ClipToBounds="True"
                    MouseEnter="OnIslandMouseEnter"
                    MouseLeave="OnIslandMouseLeave"
                    MouseLeftButtonUp="OnIslandMouseLeftButtonUp"
                    MouseRightButtonUp="OnIslandMouseRightButtonUp"
                    MouseMove="OnIslandMouseMove"
                    MouseDown="OnIslandMouseDown"
                    MouseWheel="OnIslandMouseWheel"
                    DragEnter="OnIslandDragEnter"
                    DragOver="OnIslandDragOver"
                    Drop="OnIslandDrop">

                <Grid>
                    <!-- STATE 0: TUCKED TOP EDGE HANDLE ("Tersimpan di Atas") -->
                    <Grid x:Name="TuckedHandlePanel"
                          Visibility="Collapsed"
                          Cursor="Hand"
                          ToolTip="Dynamic Island tersimpan di atas (Klik untuk membuka)">
                        <Border x:Name="TuckedAccentBar"
                                Width="56"
                                Height="2.5"
                                CornerRadius="1.25"
                                Background="#38BDF8"
                                Opacity="0.90"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                    </Grid>

                    <!-- STATE 1: IDLE PILL (Apple iOS 18 Live Activity: Date Badge + Clock + TrueDepth Sensor & Status + Wi-Fi & iOS Battery) -->
                    <Grid x:Name="IdlePillPanel"
                          Margin="14,0,14,2"
                          Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Wing: Live Date / Focus Capsule + Crisp Time -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="IdleDateBadge"
                                    Background="#1F38BDF8"
                                    BorderBrush="#3638BDF8"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="5.5,2"
                                    Margin="0,0,7,0"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="IdlePulseDot"
                                             Width="5.5" Height="5.5"
                                             Fill="#38BDF8"
                                             Margin="0,0,4.5,0"
                                             VerticalAlignment="Center"/>
                                    <TextBlock x:Name="IdleDateBadgeText"
                                               Text="MIN 25"
                                               Foreground="#38BDF8"
                                               FontSize="9.5"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="ClockTextBlock"
                                       Text="14:45"
                                       Foreground="#F8FAFC"
                                       FontSize="12.5"
                                       FontWeight="Bold"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Center Zone: Apple TrueDepth Camera Lens Housing + Live Privacy & Todo Indicators -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <!-- Subtle Apple TrueDepth Optical Lens Ring -->
                            <Border Width="24" Height="13"
                                    CornerRadius="6.5"
                                    Background="#0BFFFFFF"
                                    BorderBrush="#19FFFFFF"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="8.5" Height="8.5"
                                            CornerRadius="4.25"
                                            Background="#060913"
                                            BorderBrush="#2E38BDF8"
                                            BorderThickness="1">
                                        <Ellipse Width="2.4" Height="2.4"
                                                 Fill="#7038BDF8"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Top"
                                                 Margin="1.4,1.2,0,0"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Live Task Progress Micro-Pill (Shown when tasks exist) -->
                            <Border x:Name="IdleTodoMiniPill"
                                    Background="#1C22C55E"
                                    BorderBrush="#3522C55E"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="4.5,1"
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource GeomCheckTick}"
                                          Width="7.5" Height="7.5"
                                          Stretch="Uniform"
                                          Fill="#34D399"
                                          Margin="0,0,3,0"
                                          VerticalAlignment="Center"/>
                                    <TextBlock x:Name="IdleTodoMiniText"
                                               Text="0/0"
                                               Foreground="#34D399"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Ellipse x:Name="CameraPrivacyDot"
                                     Width="7" Height="7"
                                     Fill="#22C55E"
                                     Margin="5,0,0,0"
                                     ToolTip="Kamera sedang aktif"
                                     Visibility="Collapsed"/>
                            <Ellipse x:Name="MicPrivacyDot"
                                     Width="7" Height="7"
                                     Fill="#F97316"
                                     Margin="4,0,0,0"
                                     ToolTip="Mikrofon sedang aktif"
                                     Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- Right Wing: Wi-Fi Indicator + Authentic Apple iOS 18 Battery + Percentage -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Path x:Name="IdleWifiIconPath"
                                  Data="{StaticResource GeomWifi}"
                                  Width="11.5" Height="11.5"
                                  Stretch="Uniform"
                                  Fill="#94A3B8"
                                  Margin="0,0,7,0"
                                  VerticalAlignment="Center"/>

                            <TextBlock x:Name="IdleBatteryPercentText"
                                       Text="100%"
                                       Foreground="#F8FAFC"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Margin="0,0,5,0"
                                       VerticalAlignment="Center"/>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Sleek iOS 18 Battery Body -->
                                <Border x:Name="IdleBatteryBodyBorder"
                                        Width="24" Height="12"
                                        CornerRadius="3.8"
                                        BorderThickness="1.2"
                                        BorderBrush="#68FFFFFF"
                                        Background="#16FFFFFF"
                                        Padding="1.4"
                                        VerticalAlignment="Center">
                                    <Grid ClipToBounds="True">
                                        <Border x:Name="IdleBatteryFillBar"
                                                HorizontalAlignment="Left"
                                                Width="18.5"
                                                Height="6.8"
                                                CornerRadius="2"
                                                Background="#34D399"/>
                                        <Path x:Name="IdleBatteryBoltPath"
                                              Data="{StaticResource GeomBolt}"
                                              Width="6.5" Height="8"
                                              Stretch="Uniform"
                                              Fill="#FFFFFF"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center">
                                            <Path.Effect>
                                                <DropShadowEffect BlurRadius="3" ShadowDepth="0" Color="#000000" Opacity="0.95"/>
                                            </Path.Effect>
                                        </Path>
                                    </Grid>
                                </Border>
                                <!-- Battery Positive Terminal Cap -->
                                <Border Width="2" Height="4.5"
                                        CornerRadius="0,1.2,1.2,0"
                                        Background="#68FFFFFF"
                                        Margin="1,0,0,0"
                                        VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- STATE 2: COMPACT MEDIA PILL (Album Thumbnail + Smooth Lyric-Synced Pan + 5-Bar True Audio Spectrum) -->
                    <Grid x:Name="CompactMediaPanel"
                          Margin="14,0,14,2"
                          Visibility="Collapsed"
                          ToolTip="Hover untuk buka • Klik Kanan untuk sembunyikan ke atas • Klik Tengah untuk Play/Pause">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Mini Album Cover -->
                        <Border Grid.Column="0"
                                Width="25" Height="25"
                                CornerRadius="7"
                                Background="#181822"
                                BorderBrush="#26FFFFFF"
                                BorderThickness="1"
                                VerticalAlignment="Center"
                                ClipToBounds="True">
                            <Grid>
                                <Path Data="{StaticResource GeomMusic}"
                                      Width="11" Height="11"
                                      Stretch="Uniform"
                                      Fill="#64748B"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                                <Image x:Name="CompactAlbumImage" Stretch="UniformToFill"/>
                            </Grid>
                        </Border>

                        <!-- Live Moving Lyrics Viewport -->
                        <Border x:Name="CompactLyricViewport"
                                Grid.Column="1"
                                Margin="11,0,11,0"
                                VerticalAlignment="Center"
                                ClipToBounds="True"
                                Height="24">
                            <Canvas VerticalAlignment="Center" Height="24" ClipToBounds="True">
                                <TextBlock x:Name="CompactSongTitleText"
                                           Canvas.Left="0"
                                           Canvas.Top="3"
                                           Text="Memuat lirik lagu..."
                                           Foreground="#F8FAFC"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="CompactLyricTranslate" X="0" Y="0"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Canvas>
                        </Border>

                        <!-- 5-Bar Real-Time WASAPI Loopback Audio Spectrum -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Height="20">
                            <Rectangle x:Name="WaveBar0" Width="3.2" Height="4" RadiusX="1.6" RadiusY="1.6" Fill="#38BDF8" Margin="1.3,0" VerticalAlignment="Center"/>
                            <Rectangle x:Name="WaveBar1" Width="3.2" Height="8" RadiusX="1.6" RadiusY="1.6" Fill="#38BDF8" Margin="1.3,0" VerticalAlignment="Center"/>
                            <Rectangle x:Name="WaveBar2" Width="3.2" Height="14" RadiusX="1.6" RadiusY="1.6" Fill="#38BDF8" Margin="1.3,0" VerticalAlignment="Center"/>
                            <Rectangle x:Name="WaveBar3" Width="3.2" Height="9" RadiusX="1.6" RadiusY="1.6" Fill="#38BDF8" Margin="1.3,0" VerticalAlignment="Center"/>
                            <Rectangle x:Name="WaveBar4" Width="3.2" Height="4" RadiusX="1.6" RadiusY="1.6" Fill="#38BDF8" Margin="1.3,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- STATE 3: TOAST INTERRUPT PILL (Bespoke Vector Badge + Interactive Volume / Brightness / Battery) -->
                    <Grid x:Name="ToastPanel"
                          Margin="18,0,18,2"
                          Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="ToastIconBadge"
                                Grid.Column="0"
                                Width="32" Height="32"
                                CornerRadius="10"
                                Background="#2438BDF8"
                                BorderBrush="#30FFFFFF"
                                BorderThickness="1"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0">
                            <Path x:Name="ToastIconPath"
                                  Data="{StaticResource GeomSpeakerOn}"
                                  Width="15" Height="15"
                                  Stretch="Uniform"
                                  Fill="#38BDF8"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="ToastTitleText"
                                       Text="Volume 75%"
                                       Foreground="#F8FAFC"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ToastSubtitleText"
                                       Text="Scroll mouse atau geser slider"
                                       Foreground="#94A3B8"
                                       FontSize="10.5"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Modern Line-Only Interactive Toast Slider (Volume / Brightness) -->
                        <Grid x:Name="ToastProgressContainer"
                              Grid.Column="2"
                              Width="112"
                              Height="20"
                              Margin="14,0,2,0"
                              Background="Transparent"
                              Cursor="Hand"
                              VerticalAlignment="Center"
                              Visibility="Collapsed"
                              MouseLeftButtonDown="OnToastSliderMouseLeftButtonDown"
                              MouseMove="OnToastSliderMouseMove"
                              MouseLeftButtonUp="OnToastSliderMouseLeftButtonUp">
                            <Border x:Name="ToastProgressTrack"
                                    Width="112" Height="8"
                                    CornerRadius="4"
                                    Background="#26FFFFFF"
                                    ClipToBounds="True"
                                    VerticalAlignment="Center">
                                <Border x:Name="ToastProgressFill"
                                        HorizontalAlignment="Left"
                                        Width="65"
                                        Height="8"
                                        CornerRadius="4"
                                        Background="#38BDF8"/>
                            </Border>
                        </Grid>

                        <!-- Dedicated Vector Battery Graphic for Charger Plug/Unplug Toast -->
                        <StackPanel x:Name="ToastBatteryContainer"
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="14,0,2,0"
                                    Visibility="Collapsed">
                            <Border x:Name="ToastBatteryBody"
                                    Width="54" Height="24"
                                    CornerRadius="6.5"
                                    BorderThickness="1.6"
                                    BorderBrush="#88FFFFFF"
                                    Background="#1EFFFFFF"
                                    Padding="2.2"
                                    VerticalAlignment="Center">
                                <Grid ClipToBounds="True">
                                    <Border x:Name="ToastBatteryFill"
                                            HorizontalAlignment="Left"
                                            Width="40"
                                            Height="16.5"
                                            CornerRadius="4"
                                            Background="#22C55E"/>

                                    <Path x:Name="ToastBatteryBoltPath"
                                          Data="{StaticResource GeomBolt}"
                                          Width="11" Height="13"
                                          Stretch="Uniform"
                                          Fill="#FFFFFF"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                                        <Path.Effect>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="#000000" Opacity="0.95"/>
                                        </Path.Effect>
                                    </Path>
                                </Grid>
                            </Border>

                            <Border x:Name="ToastBatteryCap"
                                    Width="3.5" Height="10"
                                    CornerRadius="0,2,2,0"
                                    Background="#88FFFFFF"
                                    Margin="1.5,0,0,0"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- STATE 4: EXPANDED DASHBOARD (Signature Cyber-Minimalist Vector UI) -->
                    <Grid x:Name="ExpandedDashboardPanel"
                          Width="510"
                          HorizontalAlignment="Center"
                          Margin="0,10,0,12"
                          Visibility="Collapsed">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="DashboardContentTranslate" X="0"/>
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Top Switcher Bar (Segmented Pill Control with Vector SVG Icons) -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="#14FFFFFF"
                                    BorderBrush="#22FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="2.5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="TabMediaBtn"
                                            Style="{StaticResource TabPillButtonStyle}"
                                            Click="OnTabMediaClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource GeomMusic}"
                                                  Width="11" Height="11"
                                                  Stretch="Uniform"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Margin="0,0,5,0"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock Text="Musik" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="TabTodoBtn"
                                            Style="{StaticResource TabPillButtonStyle}"
                                            Click="OnTabTodoClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource GeomChecklist}"
                                                  Width="11" Height="11"
                                                  Stretch="Uniform"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Margin="0,0,5,0"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock Text="Tugas" VerticalAlignment="Center"/>
                                            <Border x:Name="TabTodoCountBadge"
                                                    Background="#2822C55E"
                                                    BorderBrush="#4022C55E"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="4,0.5"
                                                    Margin="4.5,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="Collapsed">
                                                <TextBlock x:Name="TabTodoCountText"
                                                           Text="0"
                                                           Foreground="#34D399"
                                                           FontSize="9"
                                                           FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="TabPomodoroBtn"
                                            Style="{StaticResource TabPillButtonStyle}"
                                            Click="OnTabPomodoroClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource GeomFocusTimer}"
                                                  Width="11" Height="11"
                                                  Stretch="Uniform"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Margin="0,0,5,0"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock Text="Fokus" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="TabShelfBtn"
                                            Style="{StaticResource TabPillButtonStyle}"
                                            Click="OnTabShelfClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource GeomFolderTray}"
                                                  Width="11" Height="11"
                                                  Stretch="Uniform"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Margin="0,0,5,0"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock Text="Rak File" VerticalAlignment="Center"/>
                                            <Border x:Name="TabShelfCountBadge"
                                                    Background="#2838BDF8"
                                                    BorderBrush="#4038BDF8"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="4,0.5"
                                                    Margin="4.5,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="Collapsed">
                                                <TextBlock x:Name="TabShelfCountText"
                                                           Text="0"
                                                           Foreground="#38BDF8"
                                                           FontSize="9"
                                                           FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="TabSystemBtn"
                                            Style="{StaticResource TabPillButtonStyle}"
                                            Click="OnTabSystemClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource GeomSliders}"
                                                  Width="11" Height="11"
                                                  Stretch="Uniform"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Margin="0,0,5,0"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock Text="Sistem" VerticalAlignment="Center"/>
                                            <Ellipse x:Name="TabSystemUpdateBadge"
                                                     Width="5.5" Height="5.5"
                                                     Fill="#22C55E"
                                                     Margin="4.5,0,0,0"
                                                     VerticalAlignment="Center"
                                                     Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                <Border Background="#10FFFFFF"
                                        BorderBrush="#1AFFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="6,2.5"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="ExpandedClockBadge"
                                               Text="14:25"
                                               Foreground="#94A3B8"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               FontFamily="Segoe UI Variable Display, Segoe UI"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <Button Style="{StaticResource IslandIconButtonStyle}"
                                        Padding="9,4"
                                        ToolTip="Lipat ke bibir atas layar agar tab/tombol aplikasi di belakangnya bisa diklik"
                                        Click="OnManualTuckClick">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeomChevronUp}"
                                              Width="10" Height="10"
                                              Stretch="Uniform"
                                              Fill="#CBD5E1"
                                              Margin="0,0,4,0"
                                              VerticalAlignment="Center"/>
                                        <TextBlock Text="Simpan" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Tab Content Host with Smooth Slide Animations -->
                        <Grid x:Name="TabContentContainer" Grid.Row="1" ClipToBounds="True">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="TabContentTranslate" X="0"/>
                            </Grid.RenderTransform>

                            <!-- TAB 0: MEDIA CONTROLLER + MODERN TIMELINE + FLOATING LYRICS STAGE -->
                            <Grid x:Name="MediaTabGrid" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Album Art + Song Metadata + Bespoke Vector Transport Buttons inside Apple Glass Card -->
                            <Border Grid.Row="0"
                                    Background="#0EFFFFFF"
                                    BorderBrush="#1CFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="15"
                                    Padding="9,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Modern Glowing Album Art -->
                                    <Border Grid.Column="0"
                                            Width="52" Height="52"
                                            CornerRadius="12"
                                            Background="#14141D"
                                            BorderBrush="#28FFFFFF"
                                            BorderThickness="1"
                                            ClipToBounds="True">
                                        <Border.Effect>
                                            <DropShadowEffect x:Name="AlbumShadowEffect" BlurRadius="16" ShadowDepth="2" Opacity="0.5" Color="#38BDF8"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Path Data="{StaticResource GeomMusic}"
                                                  Width="20" Height="20"
                                                  Stretch="Uniform"
                                                  Fill="#475569"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                            <Image x:Name="ExpandedAlbumImage" Stretch="UniformToFill"/>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="ExpandedSongTitleText"
                                                       Grid.Column="0"
                                                       Text="Tidak Ada Media Aktif"
                                                       Foreground="#F8FAFC"
                                                       FontSize="14.5"
                                                       FontWeight="Bold"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>

                                            <!-- Live 5-Bar Song Spectrum in Expanded Mode -->
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Height="16"
                                                        Margin="8,0,4,0">
                                                <Rectangle x:Name="ExpWaveBar0" Width="2.8" Height="4" RadiusX="1.4" RadiusY="1.4" Fill="#38BDF8" Margin="1.1,0" VerticalAlignment="Center"/>
                                                <Rectangle x:Name="ExpWaveBar1" Width="2.8" Height="7" RadiusX="1.4" RadiusY="1.4" Fill="#38BDF8" Margin="1.1,0" VerticalAlignment="Center"/>
                                                <Rectangle x:Name="ExpWaveBar2" Width="2.8" Height="11" RadiusX="1.4" RadiusY="1.4" Fill="#38BDF8" Margin="1.1,0" VerticalAlignment="Center"/>
                                                <Rectangle x:Name="ExpWaveBar3" Width="2.8" Height="7" RadiusX="1.4" RadiusY="1.4" Fill="#38BDF8" Margin="1.1,0" VerticalAlignment="Center"/>
                                                <Rectangle x:Name="ExpWaveBar4" Width="2.8" Height="4" RadiusX="1.4" RadiusY="1.4" Fill="#38BDF8" Margin="1.1,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <!-- Real-time Active Audio Destination Pill (Vector Icon + Clean Device Name) -->
                                            <Border x:Name="AudioDeviceBadge"
                                                    Background="#2038BDF8"
                                                    BorderBrush="#3238BDF8"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="6,2"
                                                    Margin="0,0,7,0"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path x:Name="AudioDeviceIconPath"
                                                          Data="{StaticResource GeomSpeakerOn}"
                                                          Width="9.5" Height="9.5"
                                                          Stretch="Uniform"
                                                          Fill="#38BDF8"
                                                          Margin="0,0,4,0"
                                                          VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="AudioDeviceBadgeText"
                                                               Text="Speaker"
                                                               Foreground="#38BDF8"
                                                               FontSize="9.5"
                                                               FontWeight="SemiBold"
                                                               MaxWidth="110"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <TextBlock x:Name="ExpandedArtistText"
                                                       Text="Putar lagu di Spotify, Chrome, Edge, atau VLC"
                                                       Foreground="#94A3B8"
                                                       FontSize="11.5"
                                                       MaxWidth="205"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Bespoke Vector Transport Buttons (Zero Emoji Boxes!) -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource IslandCircularButtonStyle}"
                                                ToolTip="Lagu Sebelumnya"
                                                Click="OnMediaPrevClick">
                                            <Path Data="{StaticResource GeomSkipPrev}"
                                                  Width="12" Height="12"
                                                  Stretch="Uniform"
                                                  Fill="#F8FAFC"/>
                                        </Button>

                                        <Button x:Name="PlayPauseButton"
                                                Style="{StaticResource PlayPauseHeroButtonStyle}"
                                                Margin="5,0"
                                                ToolTip="Play / Pause (atau Klik Tengah)"
                                                Click="OnMediaPlayPauseClick">
                                            <Path x:Name="PlayPauseIconPath"
                                                  Data="{StaticResource GeomPlay}"
                                                  Width="13.5" Height="13.5"
                                                  Stretch="Uniform"
                                                  Fill="#09090B"/>
                                        </Button>

                                        <Button Style="{StaticResource IslandCircularButtonStyle}"
                                                ToolTip="Lagu Berikutnya"
                                                Click="OnMediaNextClick">
                                            <Path Data="{StaticResource GeomSkipNext}"
                                                  Width="12" Height="12"
                                                  Stretch="Uniform"
                                                  Fill="#F8FAFC"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Interactive Draggable Timeline Scrubber Bar (Modern Line-Only) -->
                            <Grid Grid.Row="1" Margin="2,7,2,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="ElapsedTimeText"
                                           Grid.Column="0"
                                           Text="0:00"
                                           Foreground="#94A3B8"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           FontFamily="Segoe UI Variable Text, Consolas, Segoe UI"
                                           VerticalAlignment="Center"/>

                                <!-- Click & Drag Seek Hit Area -->
                                <Grid x:Name="TimelineScrubberHitArea"
                                      Grid.Column="1"
                                      Height="14"
                                      Margin="6,0"
                                      Background="Transparent"
                                      Cursor="Hand"
                                      ToolTip="Klik atau Geser (Drag) untuk mengubah posisi waktu lagu"
                                      MouseLeftButtonDown="OnTimelineMouseLeftButtonDown"
                                      MouseMove="OnTimelineMouseMove"
                                      MouseLeftButtonUp="OnTimelineMouseLeftButtonUp">
                                    <Border x:Name="TimelineTrackBorder"
                                            Height="5.5"
                                            CornerRadius="2.75"
                                            Background="#24FFFFFF"
                                            ClipToBounds="True"
                                            VerticalAlignment="Center">
                                        <Border x:Name="TimelineFillBorder"
                                                HorizontalAlignment="Left"
                                                Width="0"
                                                Height="5.5"
                                                CornerRadius="2.75"
                                                Background="#38BDF8"/>
                                    </Border>
                                </Grid>

                                <TextBlock x:Name="TotalDurationText"
                                           Grid.Column="2"
                                           Text="0:00"
                                           Foreground="#94A3B8"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           FontFamily="Segoe UI Variable Text, Consolas, Segoe UI"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- ANIMATED 3-LINE LIVE LYRICS STAGE -->
                            <Border Grid.Row="2"
                                    Background="#0EFFFFFF"
                                    BorderBrush="#1CFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="14,5"
                                    ClipToBounds="True">
                                <Grid>
                                    <Ellipse x:Name="LyricsStageGlowOrb"
                                             Width="220" Height="50"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Opacity="0.16"
                                             IsHitTestVisible="False">
                                        <Ellipse.Fill>
                                            <SolidColorBrush x:Name="LyricsStageOrbBrush" Color="#38BDF8"/>
                                        </Ellipse.Fill>
                                        <Ellipse.Effect>
                                            <BlurEffect Radius="28"/>
                                        </Ellipse.Effect>
                                    </Ellipse>

                                    <StackPanel x:Name="LyricsStageStack"
                                                VerticalAlignment="Center"
                                                RenderTransformOrigin="0.5,0.5">
                                        <StackPanel.RenderTransform>
                                            <TranslateTransform x:Name="LyricsStageTranslate" X="0" Y="0"/>
                                        </StackPanel.RenderTransform>

                                        <TextBlock x:Name="PrevLyricLineText"
                                                   Text=""
                                                   Foreground="#5594A3B8"
                                                   FontSize="11"
                                                   FontWeight="Medium"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,1.5"/>

                                        <TextBlock x:Name="CurrentLyricLineText"
                                                   Text="Lirik otomatis muncul saat lagu diputar"
                                                   Foreground="#FFFFFF"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <ScaleTransform x:Name="ActiveLyricScale" ScaleX="1.0" ScaleY="1.0"/>
                                            </TextBlock.RenderTransform>
                                            <TextBlock.Effect>
                                                <DropShadowEffect x:Name="ActiveLyricGlowEffect"
                                                                  Color="#38BDF8"
                                                                  BlurRadius="12"
                                                                  ShadowDepth="0"
                                                                  Opacity="0.55"/>
                                            </TextBlock.Effect>
                                        </TextBlock>

                                        <Border x:Name="LyricLineProgressTrack"
                                                Width="120"
                                                Height="2.5"
                                                CornerRadius="1.25"
                                                Background="#22FFFFFF"
                                                HorizontalAlignment="Center"
                                                Margin="0,4.5,0,2.5">
                                            <Border x:Name="LyricLineProgressFill"
                                                    HorizontalAlignment="Left"
                                                    Width="0"
                                                    Height="2.5"
                                                    CornerRadius="1.25"
                                                    Background="#38BDF8"/>
                                        </Border>

                                        <TextBlock x:Name="NextLyricLineText"
                                                   Text="Sinkronisasi multi-sumber otomatis (LRCLIB / Musixmatch / NetEase)"
                                                   Foreground="#99CBD5E1"
                                                   FontSize="11"
                                                   FontWeight="Medium"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- TAB 1: TO-DO LIST (Apple Reminders Style - Bisa Diedit, Ditambah, Dihapus, dan Diatur Bebas) -->
                        <Grid x:Name="TodoAndWaterTabGrid" Grid.Row="1" Visibility="Collapsed">
                            <Border Background="#0EFFFFFF"
                                    BorderBrush="#1CFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="13,9">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Bar Atas: Judul, Status Counter + Progress Pill, dan Action Bar -->
                                    <Grid Grid.Row="0" Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="22" Height="22" CornerRadius="6.5" Background="#2022C55E" BorderBrush="#3522C55E" BorderThickness="1" Margin="0,0,7.5,0" VerticalAlignment="Center">
                                                <Path Data="{StaticResource GeomChecklist}"
                                                      Width="11.5" Height="11.5"
                                                      Stretch="Uniform"
                                                      Fill="#34D399"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Daftar Tugas"
                                                       Foreground="#F8FAFC"
                                                       FontSize="12.5"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"/>
                                            <Border Background="#1822C55E"
                                                    BorderBrush="#2C22C55E"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="6,1.5"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TodoCounterText"
                                                               Text="0/0 Selesai"
                                                               Foreground="#34D399"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                    <Border x:Name="TodoProgressTrack"
                                                            Width="38"
                                                            Height="4"
                                                            CornerRadius="2"
                                                            Background="#22FFFFFF"
                                                            Margin="6,0,0,0"
                                                            ClipToBounds="True"
                                                            VerticalAlignment="Center">
                                                        <Border x:Name="TodoProgressFill"
                                                                HorizontalAlignment="Left"
                                                                Width="0"
                                                                Height="4"
                                                                CornerRadius="2"
                                                                Background="#34D399"/>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Tombol Bersihkan Selesai -->
                                        <Button x:Name="ClearCompletedTodoBtn"
                                                Grid.Column="2"
                                                Style="{StaticResource IslandIconButtonStyle}"
                                                Padding="8,3"
                                                Background="#14FFFFFF"
                                                BorderBrush="#22FFFFFF"
                                                BorderThickness="1"
                                                VerticalAlignment="Center"
                                                ToolTip="Hapus semua tugas yang sudah selesai"
                                                Click="OnClearCompletedTodoClick">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource GeomCheckCircle}"
                                                      Width="10" Height="10"
                                                      Stretch="Uniform"
                                                      Fill="#94A3B8"
                                                      Margin="0,0,4,0"
                                                      VerticalAlignment="Center"/>
                                                <TextBlock Text="Hapus Selesai"
                                                           Foreground="#94A3B8"
                                                           FontSize="10.5"
                                                           FontWeight="Medium"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Bar Tambah Tugas Cepat (Interactive Focusable Input Bar) -->
                                    <Border x:Name="NewTodoInputBorder"
                                            Grid.Row="1"
                                            Background="#16FFFFFF"
                                            BorderBrush="#2AFFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="10,4.5"
                                            Margin="0,0,0,7"
                                            Cursor="IBeam"
                                            PreviewMouseLeftButtonDown="OnTodoInputBorderMouseDown">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Path Grid.Column="0"
                                                  Data="{StaticResource GeomPlus}"
                                                  Width="11" Height="11"
                                                  Stretch="Uniform"
                                                  Fill="#38BDF8"
                                                  Margin="0,0,8,0"
                                                  VerticalAlignment="Center"/>

                                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock x:Name="TodoInputPlaceholder"
                                                           Text="Ketik tugas baru lalu tekan Enter atau klik Tambah..."
                                                           Foreground="#64748B"
                                                           FontSize="11.5"
                                                           VerticalAlignment="Center"
                                                           IsHitTestVisible="False"/>
                                                <TextBox x:Name="NewTodoInputBox"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         Foreground="#F8FAFC"
                                                         FontSize="11.5"
                                                         FontWeight="Medium"
                                                         CaretBrush="#38BDF8"
                                                         SelectionBrush="#4038BDF8"
                                                         Focusable="True"
                                                         IsTabStop="True"
                                                         Padding="0,1"
                                                         VerticalAlignment="Center"
                                                         PreviewMouseLeftButtonDown="OnTodoInputBoxMouseDown"
                                                         GotFocus="OnNewTodoInputGotFocus"
                                                         LostFocus="OnNewTodoInputLostFocus"
                                                         KeyDown="OnNewTodoInputKeyDown"
                                                         TextChanged="OnNewTodoInputTextChanged"/>
                                            </Grid>

                                            <Button x:Name="SubmitTodoBtn"
                                                    Grid.Column="2"
                                                    Style="{StaticResource IslandIconButtonStyle}"
                                                    Background="#2838BDF8"
                                                    BorderBrush="#4838BDF8"
                                                    BorderThickness="1"
                                                    Padding="10,3"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Click="OnSubmitTodoClick">
                                                <TextBlock Text="Tambah"
                                                           Foreground="#38BDF8"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold"/>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Area Daftar Tugas + Empty State Apple Reminders -->
                                    <Grid Grid.Row="2">
                                        <StackPanel x:Name="EmptyTodoHintPanel"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Visibility="Collapsed"
                                                    IsHitTestVisible="False">
                                            <Border Width="30" Height="30"
                                                    CornerRadius="9"
                                                    Background="#1422C55E"
                                                    BorderBrush="#2822C55E"
                                                    BorderThickness="1"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,0,5">
                                                <Path Data="{StaticResource GeomChecklist}"
                                                      Width="14" Height="14"
                                                      Stretch="Uniform"
                                                      Fill="#34D399"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Belum ada daftar tugas hari ini"
                                                       Foreground="#94A3B8"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       TextAlignment="Center"/>
                                            <TextBlock Text="Klik kolom input di atas, ketik tugas baru, lalu tekan Enter"
                                                       Foreground="#64748B"
                                                       FontSize="10"
                                                       Margin="0,1.5,0,0"
                                                       TextAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Items Control Daftar Tugas (Scrollable Apple-Style) -->
                                        <ScrollViewer Style="{StaticResource AppleScrollViewerStyle}"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      Padding="0,0,7,0">
                                            <ItemsControl x:Name="TodoItemsControl">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#14FFFFFF"
                                                                BorderBrush="#22FFFFFF"
                                                                BorderThickness="1"
                                                                CornerRadius="10"
                                                                Padding="9,5.5"
                                                                Margin="0,0,0,5">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Checkmark Circle -->
                                                                <Border Grid.Column="0"
                                                                        Width="18" Height="18"
                                                                        CornerRadius="9"
                                                                        Background="{Binding CheckBgBrush}"
                                                                        BorderBrush="{Binding CheckBorderBrush}"
                                                                        BorderThickness="1.3"
                                                                        Margin="0,0,9,0"
                                                                        VerticalAlignment="Center"
                                                                        Cursor="Hand"
                                                                        Tag="{Binding Id}"
                                                                        MouseLeftButtonUp="OnTodoItemClick">
                                                                    <Path Data="{StaticResource GeomCheckTick}"
                                                                          Width="9.5" Height="9.5"
                                                                          Stretch="Uniform"
                                                                          Fill="#34D399"
                                                                          Visibility="{Binding DoneCheckmarkVisibility}"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                                </Border>

                                                                <!-- Editable Todo Title -->
                                                                <TextBox Grid.Column="1"
                                                                         Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         Foreground="{Binding TitleColorBrush}"
                                                                         TextDecorations="{Binding TitleDecorations}"
                                                                         FontSize="11.5"
                                                                         FontWeight="Medium"
                                                                         Background="Transparent"
                                                                         BorderThickness="0"
                                                                         CaretBrush="#38BDF8"
                                                                         SelectionBrush="#4038BDF8"
                                                                         Focusable="True"
                                                                         VerticalAlignment="Center"
                                                                         Padding="0,1"
                                                                         Tag="{Binding Id}"
                                                                         PreviewMouseLeftButtonDown="OnTodoItemTextBoxMouseDown"
                                                                         GotFocus="OnTodoItemTextBoxGotFocus"
                                                                         LostFocus="OnTodoTitleLostFocus"
                                                                         KeyDown="OnTodoTitleKeyDown"/>

                                                                <!-- Tombol Hapus Tugas -->
                                                                <Button Grid.Column="2"
                                                                        Style="{StaticResource IslandIconButtonStyle}"
                                                                        Width="20" Height="20"
                                                                        Padding="0"
                                                                        Margin="4,0,0,0"
                                                                        VerticalAlignment="Center"
                                                                        Tag="{Binding Id}"
                                                                        ToolTip="Hapus tugas ini"
                                                                        Click="OnTodoDeleteClick">
                                                                    <Path Data="{StaticResource GeomClosePower}"
                                                                          Width="8" Height="8"
                                                                          Stretch="Uniform"
                                                                          Fill="#64748B"/>
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- TAB 3: TEMPORARY FILE DROP SHELF (Apple NotchNook / Dropover Tray Style) -->
                        <Grid x:Name="ShelfTabGrid" Grid.Row="1" Visibility="Collapsed">
                            <Border Background="#0EFFFFFF"
                                    BorderBrush="#1CFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="13,9">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,7">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="22" Height="22" CornerRadius="6.5" Background="#2038BDF8" BorderBrush="#3538BDF8" BorderThickness="1" Margin="0,0,7.5,0" VerticalAlignment="Center">
                                                <Path Data="{StaticResource GeomFolderTray}"
                                                      Width="11.5" Height="11.5"
                                                      Stretch="Uniform"
                                                      Fill="#38BDF8"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Rak File Sementara"
                                                       Foreground="#F8FAFC"
                                                       FontSize="12.5"
                                                       FontWeight="Bold"
                                                       Margin="0,0,8,0"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock x:Name="ShelfHeaderCountText"
                                                       Text="Drag Masuk &amp; Keluar"
                                                       Foreground="#94A3B8"
                                                       FontSize="10.5"
                                                       FontWeight="Medium"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button Style="{StaticResource IslandIconButtonStyle}"
                                                HorizontalAlignment="Right"
                                                Background="#14FFFFFF"
                                                BorderBrush="#22FFFFFF"
                                                BorderThickness="1"
                                                Padding="8,3"
                                                FontSize="10.5"
                                                Content="Bersihkan"
                                                Click="OnClearShelfClick"/>
                                    </Grid>

                                    <Border Grid.Row="1"
                                            Background="#0A38BDF8"
                                            BorderBrush="#2438BDF8"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="8">
                                        <Grid>
                                            <StackPanel x:Name="EmptyShelfHintPanel"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center"
                                                        Margin="14,0">
                                                <Border Width="32" Height="32"
                                                        CornerRadius="10"
                                                        Background="#1838BDF8"
                                                        BorderBrush="#2E38BDF8"
                                                        BorderThickness="1"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,0,0,6">
                                                    <Path Data="{StaticResource GeomFolderTray}"
                                                          Width="15" Height="15"
                                                          Stretch="Uniform"
                                                          Fill="#38BDF8"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Tarik file atau gambar ke sini untuk disimpan sementara"
                                                           Foreground="#CBD5E1"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           TextAlignment="Center"/>
                                                <TextBlock Text="Lalu drag keluar kapan saja ke WhatsApp, Discord, Browser, atau Folder lain"
                                                           Foreground="#64748B"
                                                           FontSize="10"
                                                           Margin="0,2,0,0"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"/>
                                            </StackPanel>

                                            <ScrollViewer Style="{StaticResource AppleScrollViewerStyle}"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl x:Name="ShelfItemsControl">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#1EFFFFFF"
                                                                    BorderBrush="#32FFFFFF"
                                                                    BorderThickness="1"
                                                                    CornerRadius="10"
                                                                    Padding="8,6"
                                                                    Margin="3"
                                                                    Cursor="Hand"
                                                                    MouseMove="OnShelfItemMouseMove">
                                                                <Border.ToolTip>
                                                                    <ToolTip Background="#0F172A" BorderBrush="#334155" Padding="8">
                                                                        <StackPanel>
                                                                            <Image Source="{Binding PreviewImage}"
                                                                                   MaxWidth="180"
                                                                                   MaxHeight="140"
                                                                                   Stretch="Uniform"
                                                                                   Margin="0,0,0,6"
                                                                                   Visibility="{Binding PreviewImageVisibility}"/>
                                                                            <TextBlock Text="{Binding FileName}" Foreground="#F8FAFC" FontWeight="Bold" FontSize="11.5"/>
                                                                            <TextBlock Text="Tarik (Drag) keluar untuk mengirim file ini" Foreground="#94A3B8" FontSize="10"/>
                                                                        </StackPanel>
                                                                    </ToolTip>
                                                                </Border.ToolTip>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Border Width="38" Height="38"
                                                                            CornerRadius="8"
                                                                            Background="#1E293B"
                                                                            BorderBrush="#30FFFFFF"
                                                                            BorderThickness="1"
                                                                            Margin="0,0,8,0"
                                                                            ClipToBounds="True">
                                                                        <Grid>
                                                                            <TextBlock Text="{Binding IconGlyph}"
                                                                                       FontSize="10"
                                                                                       FontWeight="Bold"
                                                                                       Foreground="#38BDF8"
                                                                                       HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center"
                                                                                       Visibility="{Binding IconGlyphVisibility}"/>
                                                                            <Image Source="{Binding PreviewImage}"
                                                                                   Stretch="UniformToFill"
                                                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                                                   Visibility="{Binding PreviewImageVisibility}"/>
                                                                        </Grid>
                                                                    </Border>

                                                                    <StackPanel MaxWidth="130" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding FileName}"
                                                                                   Foreground="#F8FAFC"
                                                                                   FontSize="11.5"
                                                                                   FontWeight="SemiBold"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Text="{Binding SizeLabel}"
                                                                                   Foreground="#94A3B8"
                                                                                   FontSize="10"
                                                                                   Margin="0,2,0,0"/>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- TAB 2: POMODORO & FOCUS TIMER (Apple Watch Activity Ring & Dual Glass Bento Layout) -->
                        <Grid x:Name="PomodoroTabGrid" Grid.Row="1" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Kolom Kiri: Circular Timer Ring Progress -->
                            <Border Grid.Column="0"
                                    Background="#0EFFFFFF"
                                    BorderBrush="#1CFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="8"
                                    Margin="0,0,10,0">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Background Circular Track -->
                                    <Ellipse Width="86" Height="86"
                                             Stroke="#22FFFFFF"
                                             StrokeThickness="5.5"/>

                                    <!-- Active Glowing Circular Progress Arc -->
                                    <Path x:Name="PomodoroProgressRingPath"
                                          Stroke="#EF4444"
                                          StrokeThickness="5.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round">
                                        <Path.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#EF4444" Opacity="0.8"/>
                                        </Path.Effect>
                                    </Path>

                                    <!-- Center Stopwatch Icon + Percentage Readout -->
                                    <Border Width="48" Height="48"
                                            CornerRadius="24"
                                            Background="#1CEF4444"
                                            BorderBrush="#30EF4444"
                                            BorderThickness="1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource GeomFocusTimer}"
                                                  Width="13" Height="13"
                                                  Stretch="Uniform"
                                                  Fill="#EF4444"
                                                  HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="PomodoroPercentText"
                                                       Text="100%"
                                                       Foreground="#F8FAFC"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       Margin="0,1,0,0"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Kolom Kanan: Digital Clock, State & Controls inside Matching Glass Card -->
                            <Border Grid.Column="1"
                                    Background="#0EFFFFFF"
                                    BorderBrush="#1CFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="14,10">
                                <StackPanel VerticalAlignment="Center">
                                    <Grid Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="PomodoroTimeText"
                                                       Text="25:00"
                                                       Foreground="#F8FAFC"
                                                       FontSize="28"
                                                       FontWeight="Bold"
                                                       FontFamily="Segoe UI Variable Display, Consolas, Segoe UI"
                                                       VerticalAlignment="Center"/>
                                            <Border x:Name="PomodoroModeBadge"
                                                    Background="#20EF4444"
                                                    BorderBrush="#38EF4444"
                                                    BorderThickness="1"
                                                    CornerRadius="7"
                                                    Padding="7,2.5"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse x:Name="PomodoroModeDot"
                                                             Width="5.5" Height="5.5"
                                                             Fill="#EF4444"
                                                             Margin="0,0,5,0"
                                                             VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="PomodoroModeLabel"
                                                               Text="Sesi Fokus"
                                                               Foreground="#F8FAFC"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <Button Style="{StaticResource IslandIconButtonStyle}"
                                                HorizontalAlignment="Right"
                                                Background="#14FFFFFF"
                                                BorderBrush="#22FFFFFF"
                                                BorderThickness="1"
                                                Padding="7,5"
                                                ToolTip="Ulangi dari awal"
                                                Click="OnPomodoroResetFocusClick">
                                            <Path Data="{StaticResource GeomRefresh}"
                                                  Width="11" Height="11"
                                                  Stretch="Uniform"
                                                  Fill="#94A3B8"/>
                                        </Button>
                                    </Grid>

                                    <!-- Tombol Aksi Kapsul Modern -->
                                    <WrapPanel Margin="0,4,0,0">
                                        <!-- Hero Play/Pause Red Pill Button -->
                                        <Button x:Name="PomodoroStartPauseBtn"
                                                Style="{StaticResource IslandIconButtonStyle}"
                                                Background="#EF4444"
                                                BorderThickness="0"
                                                Padding="14,6"
                                                Margin="0,0,6,6"
                                                Click="OnPomodoroStartPauseClick">
                                            <Button.Effect>
                                                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#EF4444" Opacity="0.5"/>
                                            </Button.Effect>
                                            <StackPanel Orientation="Horizontal">
                                                <Path x:Name="PomodoroPlayPauseIconPath"
                                                      Data="{StaticResource GeomPlay}"
                                                      Width="11" Height="11"
                                                      Stretch="Uniform"
                                                      Fill="#FFFFFF"
                                                      Margin="0,0,5,0"
                                                      VerticalAlignment="Center"/>
                                                <TextBlock x:Name="PomodoroStartPauseText"
                                                           Text="Mulai"
                                                           Foreground="#FFFFFF"
                                                           FontWeight="Bold"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="PomodoroBreakBtn"
                                                Style="{StaticResource IslandIconButtonStyle}"
                                                Background="#14FFFFFF"
                                                BorderBrush="#22FFFFFF"
                                                BorderThickness="1"
                                                Padding="11,6"
                                                Margin="0,0,6,6"
                                                Click="OnPomodoroBreakClick">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource GeomCupDrink}"
                                                      Width="11" Height="11"
                                                      Stretch="Uniform"
                                                      Fill="#38BDF8"
                                                      Margin="0,0,4,0"
                                                      VerticalAlignment="Center"/>
                                                <TextBlock Text="Istirahat 5m" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Style="{StaticResource IslandIconButtonStyle}"
                                                Background="#14FFFFFF"
                                                BorderBrush="#22FFFFFF"
                                                BorderThickness="1"
                                                Padding="11,6"
                                                Margin="0,0,6,6"
                                                Click="OnPomodoroResetFocusClick">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource GeomFocusTimer}"
                                                      Width="11" Height="11"
                                                      Stretch="Uniform"
                                                      Fill="#EF4444"
                                                      Margin="0,0,4,0"
                                                      VerticalAlignment="Center"/>
                                                <TextBlock Text="Fokus 25m" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Style="{StaticResource IslandIconButtonStyle}"
                                                Background="#14FFFFFF"
                                                BorderBrush="#22FFFFFF"
                                                BorderThickness="1"
                                                Padding="9,6"
                                                Margin="0,0,0,6"
                                                Content="+5m"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Click="OnPomodoroAdd5MinClick"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- TAB 4: SYSTEM CONTROL CENTER (macOS Sequoia Control Center Bento Grid) -->
                        <Grid x:Name="SystemTabGrid" Grid.Row="1" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0: Interactive Volume & Brightness Sliders (Overlap-Free 2-Column Headers!) -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Volume Slider Card -->
                                <Border Grid.Column="0"
                                        Background="#12FFFFFF"
                                        BorderBrush="#22FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="12,8"
                                        Margin="0,0,5,0">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Path x:Name="SysVolumeHeaderIconPath"
                                                  Grid.Column="0"
                                                  Data="{StaticResource GeomSpeakerOn}"
                                                  Width="11" Height="11"
                                                  Stretch="Uniform"
                                                  Fill="#38BDF8"
                                                  Margin="0,0,5,0"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SysVolumeLabelText"
                                                       Grid.Column="1"
                                                       Text="VOLUME AUDIO"
                                                       Foreground="#CBD5E1"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Margin="0,0,6,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SysVolumePercentText"
                                                       Grid.Column="2"
                                                       Text="65%"
                                                       Foreground="#38BDF8"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid x:Name="SysVolumeSliderHitArea"
                                              Height="16"
                                              Background="Transparent"
                                              Cursor="Hand"
                                              ToolTip="Klik atau Geser untuk mengatur Volume sistem"
                                              MouseLeftButtonDown="OnSysVolumeMouseDown"
                                              MouseMove="OnSysVolumeMouseMove"
                                              MouseLeftButtonUp="OnSysVolumeMouseUp">
                                            <Border x:Name="SysVolumeTrackBorder"
                                                    Height="8"
                                                    CornerRadius="4"
                                                    Background="#28FFFFFF"
                                                    ClipToBounds="True"
                                                    VerticalAlignment="Center">
                                                <Border x:Name="SysVolumeFillBorder"
                                                        HorizontalAlignment="Left"
                                                        Width="110"
                                                        Height="8"
                                                        CornerRadius="4"
                                                        Background="#38BDF8"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Brightness Slider Card -->
                                <Border Grid.Column="1"
                                        Background="#12FFFFFF"
                                        BorderBrush="#22FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="12,8"
                                        Margin="5,0,0,0">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0"
                                                  Data="{StaticResource GeomBrightnessSun}"
                                                  Width="11" Height="11"
                                                  Stretch="Uniform"
                                                  Fill="#FBBF24"
                                                  Margin="0,0,5,0"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="KECERAHAN LAYAR"
                                                       Foreground="#CBD5E1"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Margin="0,0,6,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SysBrightnessPercentText"
                                                       Grid.Column="2"
                                                       Text="20%"
                                                       Foreground="#FBBF24"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid x:Name="SysBrightnessSliderHitArea"
                                              Height="16"
                                              Background="Transparent"
                                              Cursor="Hand"
                                              ToolTip="Klik atau Geser untuk mengatur Kecerahan Layar"
                                              MouseLeftButtonDown="OnSysBrightnessMouseDown"
                                              MouseMove="OnSysBrightnessMouseMove"
                                              MouseLeftButtonUp="OnSysBrightnessMouseUp">
                                            <Border x:Name="SysBrightnessTrackBorder"
                                                    Height="8"
                                                    CornerRadius="4"
                                                    Background="#28FFFFFF"
                                                    ClipToBounds="True"
                                                    VerticalAlignment="Center">
                                                <Border x:Name="SysBrightnessFillBorder"
                                                        HorizontalAlignment="Left"
                                                        Width="40"
                                                        Height="8"
                                                        CornerRadius="4"
                                                        Background="#FBBF24"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Row 1: Telemetry Info Cards with Vector Icons -->
                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="#10FFFFFF"
                                        BorderBrush="#1EFFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="11"
                                        Padding="11,6"
                                        Margin="0,0,5,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource GeomBolt}"
                                                  Width="10" Height="11"
                                                  Stretch="Uniform"
                                                  Fill="#22C55E"
                                                  Margin="0,0,5,0"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SysBatteryDetailText"
                                                       Text="100% (AC Connected)"
                                                       Foreground="#F8FAFC"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="SysNetworkDetailText"
                                                   Text="Wi-Fi Terhubung"
                                                   Foreground="#94A3B8"
                                                   FontSize="10"
                                                   Margin="0,1,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1"
                                        Background="#10FFFFFF"
                                        BorderBrush="#1EFFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="11"
                                        Padding="11,6"
                                        Margin="5,0,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Path x:Name="SysPrivacyIconPath"
                                                  Data="{StaticResource GeomShield}"
                                                  Width="10.5" Height="11"
                                                  Stretch="Uniform"
                                                  Fill="#22C55E"
                                                  Margin="0,0,5,0"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SysPrivacyDetailText"
                                                       Text="Kamera &amp; Mic Aman"
                                                       Foreground="#22C55E"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="SysMemoryDetailText"
                                                   Text="RAM Island: ~26 MB (0% Idle)"
                                                   Foreground="#94A3B8"
                                                   FontSize="10"
                                                   Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Row 2: Software Update & Release Notification Card -->
                            <Border Grid.Row="2"
                                    x:Name="SysUpdateCardBorder"
                                    Background="#10FFFFFF"
                                    BorderBrush="#1EFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="11"
                                    Padding="10,6"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Path x:Name="SysUpdateIconPath"
                                          Grid.Column="0"
                                          Data="{StaticResource GeomShield}"
                                          Width="12.5" Height="12.5"
                                          Stretch="Uniform"
                                          Fill="#22C55E"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="SysUpdateStatusText"
                                                   Text="Windows Dynamic Island v1.4.1 (Terbaru)"
                                                   Foreground="#F8FAFC"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="SysUpdateSubText"
                                                   Text="Sistem terpasang versi paling mutakhir"
                                                   Foreground="#94A3B8"
                                                   FontSize="9.5"
                                                   Margin="0,1,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="SysCheckUpdateBtn"
                                                Style="{StaticResource IslandIconButtonStyle}"
                                                Padding="8,4"
                                                Margin="4,0,0,0"
                                                ToolTip="Periksa pembaruan rilis terbaru di GitHub"
                                                Click="OnCheckUpdateClick">
                                            <StackPanel Orientation="Horizontal">
                                                <Path x:Name="SysCheckUpdateIcon"
                                                      Data="{StaticResource GeomRefresh}"
                                                      Width="9.5" Height="9.5"
                                                      Stretch="Uniform"
                                                      Fill="#38BDF8"
                                                      Margin="0,0,4,0"
                                                      VerticalAlignment="Center"/>
                                                <TextBlock x:Name="SysCheckUpdateBtnText"
                                                           Text="Cek Update"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="SysInstallUpdateBtn"
                                                Style="{StaticResource IslandIconButtonStyle}"
                                                Background="#222C5E"
                                                BorderBrush="#22C55E"
                                                Padding="8,4"
                                                Margin="5,0,0,0"
                                                Visibility="Collapsed"
                                                ToolTip="Unduh dan pasang pembaruan versi terbaru sekarang"
                                                Click="OnInstallUpdateClick">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource GeomUpdate}"
                                                      Width="10" Height="10"
                                                      Stretch="Uniform"
                                                      Fill="#22C55E"
                                                      Margin="0,0,4,0"
                                                      VerticalAlignment="Center"/>
                                                <TextBlock Text="Update Sekarang"
                                                           Foreground="#22C55E"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Row 3: Sound Mute, Mic Mute, Tuck & Exit Buttons with Bespoke Vector Icons -->
                            <WrapPanel Grid.Row="3" Orientation="Horizontal">
                                <Button x:Name="ToggleMuteBtn"
                                        Style="{StaticResource IslandIconButtonStyle}"
                                        Padding="11,6"
                                        Margin="0,0,6,0"
                                        ToolTip="Mute / Unmute Suara Output Sistem"
                                        Click="OnToggleMuteClick">
                                    <StackPanel Orientation="Horizontal">
                                        <Path x:Name="ToggleMuteIconPath"
                                              Data="{StaticResource GeomSpeakerOn}"
                                              Width="11.5" Height="11.5"
                                              Stretch="Uniform"
                                              Fill="#38BDF8"
                                              Margin="0,0,5.5,0"
                                              VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ToggleMuteText"
                                                   Text="Sound: ON"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="ToggleMicMuteBtn"
                                        Style="{StaticResource IslandIconButtonStyle}"
                                        Padding="11,6"
                                        Margin="0,0,6,0"
                                        ToolTip="Mute / Unmute Mikrofon Secara Global"
                                        Click="OnToggleMicMuteClick">
                                    <StackPanel Orientation="Horizontal">
                                        <Path x:Name="ToggleMicIconPath"
                                              Data="{StaticResource GeomMicOn}"
                                              Width="11.5" Height="11.5"
                                              Stretch="Uniform"
                                              Fill="#22C55E"
                                              Margin="0,0,5.5,0"
                                              VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ToggleMicText"
                                                   Text="Mic: ON"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource IslandIconButtonStyle}"
                                        Padding="11,6"
                                        Margin="0,0,6,0"
                                        ToolTip="Lipat pulau ke bibir atas layar"
                                        Click="OnManualTuckClick">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeomChevronUp}"
                                              Width="10.5" Height="10.5"
                                              Stretch="Uniform"
                                              Fill="#CBD5E1"
                                              Margin="0,0,4.5,0"
                                              VerticalAlignment="Center"/>
                                        <TextBlock Text="Simpan"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource IslandIconButtonStyle}"
                                        Visibility="Collapsed"
                                        Padding="11,6"
                                        Margin="0,0,6,0"
                                        ToolTip="Buka file log error dan diagnostik lengkap"
                                        Click="OnOpenLogClick">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeomTerminalLog}"
                                              Width="10.5" Height="10.5"
                                              Stretch="Uniform"
                                              Fill="#38BDF8"
                                              Margin="0,0,4.5,0"
                                              VerticalAlignment="Center"/>
                                        <TextBlock Text="Log"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource IslandIconButtonStyle}"
                                        Padding="11,6"
                                        Click="OnExitAppClick">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeomClosePower}"
                                              Width="10.5" Height="10.5"
                                              Stretch="Uniform"
                                              Fill="#F87171"
                                              Margin="0,0,4.5,0"
                                              VerticalAlignment="Center"/>
                                        <TextBlock Text="Keluar"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F87171"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Grid>
                        </Grid>

                        <!-- BOTTOM PAGINATION DOTS (Sesuai Referensi Gambar 3 & 4) -->
                        <StackPanel x:Name="DotsPaginationPanel"
                                    Grid.Row="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,8,0,0">
                            <Border x:Name="PageDot0" Width="16" Height="3.5" CornerRadius="2" Background="#38BDF8" Margin="3,0" Cursor="Hand" ToolTip="Musik" MouseLeftButtonUp="OnDot0Click"/>
                            <Border x:Name="PageDot1" Width="4" Height="3.5" CornerRadius="2" Background="#30FFFFFF" Margin="3,0" Cursor="Hand" ToolTip="Tugas" MouseLeftButtonUp="OnDot1Click"/>
                            <Border x:Name="PageDot2" Width="4" Height="3.5" CornerRadius="2" Background="#30FFFFFF" Margin="3,0" Cursor="Hand" ToolTip="Fokus" MouseLeftButtonUp="OnDot2Click"/>
                            <Border x:Name="PageDot3" Width="4" Height="3.5" CornerRadius="2" Background="#30FFFFFF" Margin="3,0" Cursor="Hand" ToolTip="Rak File" MouseLeftButtonUp="OnDot3Click"/>
                            <Border x:Name="PageDot4" Width="4" Height="3.5" CornerRadius="2" Background="#30FFFFFF" Margin="3,0" Cursor="Hand" ToolTip="Sistem" MouseLeftButtonUp="OnDot4Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
