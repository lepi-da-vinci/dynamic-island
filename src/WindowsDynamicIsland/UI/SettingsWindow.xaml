                                                    <Border Width="12" Height="12" CornerRadius="6" Background="#18181B" BorderBrush="#E4E4E7" BorderThickness="1.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Monochrome" Foreground="#F8FAFC" FontSize="10.8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

