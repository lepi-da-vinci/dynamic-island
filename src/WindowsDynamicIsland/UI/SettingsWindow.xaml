                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                                <TextBlock Text="{Binding [Settings_AutoHideFullscreen], Source={x:Static svc:LocalizationService.Instance}}"
                                                           Foreground="#F8FAFC"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding [Settings_AutoHideFullscreenSub], Source={x:Static svc:LocalizationService.Instance}}"
