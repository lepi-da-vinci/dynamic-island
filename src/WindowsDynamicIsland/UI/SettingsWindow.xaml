<Window x:Class="WindowsDynamicIsland.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pengaturan — Windows Dynamic Island"
        Icon="pack://application:,,,/Assets/app_icon.ico"
        Width="740"
        Height="530"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Margin="16">
        <!-- Main macOS System Settings Window Frame -->
        <Border Background="#16161A"
                BorderBrush="#26FFFFFF"
                BorderThickness="1"
                CornerRadius="14"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.68" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="206"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ========================================================= -->
                <!-- LEFT SIDEBAR (macOS Ventura / Sequoia Style Navigation)   -->
                <!-- ========================================================= -->
                <Border Grid.Column="0"
                        Background="#111114"
                        CornerRadius="14,0,0,14"
                        MouseLeftButtonDown="OnTitleBarDragMove">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Top-Left macOS Traffic Light Buttons -->
                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="16,0,0,0">
                            <!-- Close Button (Red) -->
                            <Button Width="12" Height="12"
                                    Cursor="Hand"
                                    ToolTip="Tutup Pengaturan"
                                    Click="OnCloseButtonClick"
                                    Margin="0,0,8,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CloseDot"
                                                Width="12" Height="12"
                                                CornerRadius="6"
                                                Background="#FF5F56"
                                                BorderBrush="#30000000"
                                                BorderThickness="0.5"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CloseDot" Property="Background" Value="#FF3B30"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Minimize Button (Amber) -->
                            <Button Width="12" Height="12"
                                    Cursor="Hand"
                                    ToolTip="Minimize"
                                    Click="OnMinimizeButtonClick"
                                    Margin="0,0,8,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="MinDot"
                                                Width="12" Height="12"
                                                CornerRadius="6"
                                                Background="#FFBD2E"
                                                BorderBrush="#30000000"
                                                BorderThickness="0.5"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="MinDot" Property="Background" Value="#F59E0B"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <!-- 10 Sidebar Categories with Squircle Icon Badges -->
                        <ScrollViewer Grid.Row="1"
                                      Style="{StaticResource AppleScrollViewerStyle}"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="10,2,10,10">
                            <StackPanel>
                                <!-- 0. General -->
                                <RadioButton x:Name="NavGeneralBtn"
                                             GroupName="SettingsNav"
                                             Style="{StaticResource AppleSidebarNavButtonStyle}"
                                             IsChecked="True"
                                             Tag="0"
                                             Checked="OnNavCategoryChecked">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="22" Height="22" CornerRadius="6" Background="#64748B" Margin="0,0,10,0">
                                            <Path Data="{StaticResource GeomSettingsGear}" Width="12" Height="12" Stretch="Uniform" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="General" FontSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <!-- 1. Display -->
                                <RadioButton x:Name="NavDisplayBtn"
                                             GroupName="SettingsNav"
                                             Style="{StaticResource AppleSidebarNavButtonStyle}"
                                             Tag="1"
                                             Checked="OnNavCategoryChecked">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="22" Height="22" CornerRadius="6" Background="#8B5CF6" Margin="0,0,10,0">
                                            <Path Data="{StaticResource GeomDisplayMonitor}" Width="12" Height="12" Stretch="Uniform" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Display" FontSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <!-- 2. Appearance -->
                                <RadioButton x:Name="NavAppearanceBtn"
                                             GroupName="SettingsNav"
                                             Style="{StaticResource AppleSidebarNavButtonStyle}"
                                             Tag="2"
                                             Checked="OnNavCategoryChecked">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="22" Height="22" CornerRadius="6" Background="#475569" Margin="0,0,10,0">
                                            <Path Data="{StaticResource GeomAppearanceSparkle}" Width="12" Height="12" Stretch="Uniform" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Appearance" FontSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <!-- 3. Music and lyrics -->
                                <RadioButton x:Name="NavMusicBtn"
                                             GroupName="SettingsNav"
                                             Style="{StaticResource AppleSidebarNavButtonStyle}"
                                             Tag="3"
                                             Checked="OnNavCategoryChecked">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="22" Height="22" CornerRadius="6" Background="#F43F5E" Margin="0,0,10,0">
                                            <Path Data="{StaticResource GeomMusic}" Width="11.5" Height="11.5" Stretch="Uniform" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Music and lyrics" FontSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <!-- 4. To-do -->
                                <RadioButton x:Name="NavTodoBtn"
                                             GroupName="SettingsNav"
                                             Style="{StaticResource AppleSidebarNavButtonStyle}"
                                             Tag="4"
                                             Checked="OnNavCategoryChecked">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="22" Height="22" CornerRadius="6" Background="#22C55E" Margin="0,0,10,0">
                                            <Path Data="{StaticResource GeomChecklist}" Width="11.5" Height="11.5" Stretch="Uniform" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="To-do" FontSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <!-- 5. Calendar -->
                                <RadioButton x:Name="NavCalendarBtn"
                                             GroupName="SettingsNav"
                                             Style="{StaticResource AppleSidebarNavButtonStyle}"
                                             Tag="5"
                                             Checked="OnNavCategoryChecked">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="22" Height="22" CornerRadius="6" Background="#EF4444" Margin="0,0,10,0">
                                            <Path Data="{StaticResource GeomCalendar}" Width="11.5" Height="11.5" Stretch="Uniform" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Calendar" FontSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <!-- 6. Pomodoro -->
                                <RadioButton x:Name="NavPomodoroBtn"
                                             GroupName="SettingsNav"
                                             Style="{StaticResource AppleSidebarNavButtonStyle}"
                                             Tag="6"
                                             Checked="OnNavCategoryChecked">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="22" Height="22" CornerRadius="6" Background="#F97316" Margin="0,0,10,0">
                                            <Path Data="{StaticResource GeomFocusTimer}" Width="12" Height="12" Stretch="Uniform" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Pomodoro" FontSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <!-- 7. Water -->
                                <RadioButton x:Name="NavWaterBtn"
                                             GroupName="SettingsNav"
                                             Style="{StaticResource AppleSidebarNavButtonStyle}"
                                             Tag="7"
                                             Checked="OnNavCategoryChecked">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="22" Height="22" CornerRadius="6" Background="#3B82F6" Margin="0,0,10,0">
                                            <Path Data="{StaticResource GeomWaterDrop}" Width="11.5" Height="11.5" Stretch="Uniform" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Water" FontSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <!-- 8. Shelf -->
                                <RadioButton x:Name="NavShelfBtn"
                                             GroupName="SettingsNav"
                                             Style="{StaticResource AppleSidebarNavButtonStyle}"
                                             Tag="8"
                                             Checked="OnNavCategoryChecked">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="22" Height="22" CornerRadius="6" Background="#F59E0B" Margin="0,0,10,0">
                                            <Path Data="{StaticResource GeomFolderTray}" Width="11.5" Height="11.5" Stretch="Uniform" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Shelf" FontSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <!-- 9. HUD & popups -->
                                <RadioButton x:Name="NavHudBtn"
                                             GroupName="SettingsNav"
                                             Style="{StaticResource AppleSidebarNavButtonStyle}"
                                             Tag="9"
                                             Checked="OnNavCategoryChecked">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="22" Height="22" CornerRadius="6" Background="#0EA5E9" Margin="0,0,10,0">
                                            <Path Data="{StaticResource GeomHudLayers}" Width="12" Height="12" Stretch="Uniform" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="HUD &amp; popups" FontSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Bottom Version & Quick Tuck Footer -->
                        <Border Grid.Row="2"
                                BorderBrush="#14FFFFFF"
                                BorderThickness="0,1,0,0"
                                Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Dynamic Island" Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="SidebarVersionText" Text="v1.5.0 • macOS Edition" Foreground="#64748B" FontSize="9.5"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Vertical Hairline Divider -->
                <Border Grid.Column="1" Background="#1EFFFFFF"/>

                <!-- ========================================================= -->
                <!-- RIGHT CONTENT PANE                                        -->
                <!-- ========================================================= -->
                <Grid Grid.Column="2" Background="#16161A">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="54"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Category Header Bar (Draggable) -->
                    <Border Grid.Row="0"
                            Background="Transparent"
                            Padding="26,0,22,0"
                            MouseLeftButtonDown="OnTitleBarDragMove">
                        <Grid>
                            <TextBlock x:Name="PageHeaderTitleText"
                                       Text="General"
                                       Foreground="#F8FAFC"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                            <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource IslandIconButtonStyle}"
                                    Padding="10,5"
                                    Click="OnCloseButtonClick">
                                <TextBlock Text="Selesai" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Scrollable Settings Content -->
                    <ScrollViewer Grid.Row="1"
                                  Style="{StaticResource AppleScrollViewerStyle}"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="26,2,26,24">
                        <Grid>
                            <!-- ===================================================== -->
                            <!-- PAGE 0: GENERAL (Matches Reference Screenshot!)       -->
                            <!-- ===================================================== -->
                            <StackPanel x:Name="PageGeneral" Visibility="Visible">
                                <TextBlock Text="Startup"
                                           Foreground="#64748B"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Margin="2,0,0,6"/>

                                <!-- Startup Card -->
                                <Border Background="#1F1F25"
                                        BorderBrush="#1AFFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="16,13"
                                        Margin="0,0,0,18">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Start with Windows"
                                                       Foreground="#F8FAFC"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="Jalankan Dynamic Island otomatis saat Windows menyala"
                                                       Foreground="#94A3B8"
                                                       FontSize="11"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkStartWithWindows"
                                                  Grid.Column="1"
                                                  Style="{StaticResource AppleToggleSwitchStyle}"
                                                  VerticalAlignment="Center"
                                                  Click="OnSettingToggleClicked"/>
                                    </Grid>
                                </Border>

                                <TextBlock Text="Notch"
                                           Foreground="#64748B"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Margin="2,0,0,6"/>

                                <!-- Notch Customization Card (Size, Minimal notch, Mascot, Auto-Simpan) -->
                                <Border Background="#1F1F25"
                                        BorderBrush="#1AFFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="16,14"
                                        Margin="0,0,0,18">
                                    <StackPanel>
                                        <!-- Size Segmented Control -->
                                        <TextBlock Text="Size"
                                                   Foreground="#F8FAFC"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Skala ukuran Dynamic Island diterapkan langsung secara real-time"
                                                   Foreground="#94A3B8"
                                                   FontSize="11"
                                                   Margin="0,2,0,10"/>

                                        <Border Background="#141418"
                                                BorderBrush="#1AFFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="2">
                                            <UniformGrid Columns="5">
                                                <RadioButton x:Name="SizeAutoBtn" GroupName="NotchSize" Style="{StaticResource AppleSegmentOptionStyle}" Content="Auto" Tag="0" Click="OnNotchSizeClicked"/>
                                                <RadioButton x:Name="Size100Btn" GroupName="NotchSize" Style="{StaticResource AppleSegmentOptionStyle}" Content="100%" Tag="100" Click="OnNotchSizeClicked"/>
                                                <RadioButton x:Name="Size115Btn" GroupName="NotchSize" Style="{StaticResource AppleSegmentOptionStyle}" Content="115%" Tag="115" Click="OnNotchSizeClicked"/>
                                                <RadioButton x:Name="Size130Btn" GroupName="NotchSize" Style="{StaticResource AppleSegmentOptionStyle}" Content="130%" Tag="130" Click="OnNotchSizeClicked"/>
                                                <RadioButton x:Name="Size150Btn" GroupName="NotchSize" Style="{StaticResource AppleSegmentOptionStyle}" Content="150%" Tag="150" Click="OnNotchSizeClicked"/>
                                            </UniformGrid>
                                        </Border>

                                        <Border Height="1" Background="#14FFFFFF" Margin="0,14"/>

                                        <!-- Minimal notch -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Minimal notch"
                                                           Foreground="#F8FAFC"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="A smaller pill when nothing is playing"
                                                           Foreground="#94A3B8"
                                                           FontSize="11"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkMinimalNotch"
                                                      Grid.Column="1"
                                                      Style="{StaticResource AppleToggleSwitchStyle}"
                                                      VerticalAlignment="Center"
                                                      Click="OnSettingToggleClicked"/>
                                        </Grid>

                                        <Border Height="1" Background="#14FFFFFF" Margin="0,14"/>

                                        <!-- Island mascot -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Island mascot"
                                                           Foreground="#F8FAFC"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="A little friend that lives in the notch"
                                                           Foreground="#94A3B8"
                                                           FontSize="11"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkMascot"
                                                      Grid.Column="1"
                                                      Style="{StaticResource AppleToggleSwitchStyle}"
                                                      VerticalAlignment="Center"
                                                      Click="OnSettingToggleClicked"/>
                                        </Grid>

                                        <Border Height="1" Background="#14FFFFFF" Margin="0,14"/>

                                        <!-- Auto-Simpan (Auto-Tuck) -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Auto-Simpan (Auto-Tuck)"
                                                           Foreground="#F8FAFC"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="Otomatis simpan ke atas setelah tampilan normal muncul"
                                                           Foreground="#94A3B8"
                                                           FontSize="11"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkAutoTuck"
                                                      Grid.Column="1"
                                                      Style="{StaticResource AppleToggleSwitchStyle}"
                                                      VerticalAlignment="Center"
                                                      Click="OnSettingToggleClicked"/>
                                        </Grid>

                                        <Border Background="#141418"
                                                BorderBrush="#1AFFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="2"
                                                Margin="0,10,0,0">
                                            <UniformGrid Columns="4">
                                                <RadioButton x:Name="Tuck5sBtn" GroupName="TuckDelay" Style="{StaticResource AppleSegmentOptionStyle}" Content="5 Detik" Tag="5" Click="OnTuckDelayClicked"/>
                                                <RadioButton x:Name="Tuck10sBtn" GroupName="TuckDelay" Style="{StaticResource AppleSegmentOptionStyle}" Content="10 Detik" Tag="10" Click="OnTuckDelayClicked"/>
                                                <RadioButton x:Name="Tuck15sBtn" GroupName="TuckDelay" Style="{StaticResource AppleSegmentOptionStyle}" Content="15 Detik" Tag="15" Click="OnTuckDelayClicked"/>
                                                <RadioButton x:Name="Tuck30sBtn" GroupName="TuckDelay" Style="{StaticResource AppleSegmentOptionStyle}" Content="30 Detik" Tag="30" Click="OnTuckDelayClicked"/>
                                            </UniformGrid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Pembaruan Aplikasi"
                                           Foreground="#64748B"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Margin="2,0,0,6"/>

                                <!-- Software Update Card -->
                                <Border Background="#1F1F25"
                                        BorderBrush="#1AFFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="16,13">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock x:Name="SettingsUpdateTitleText"
                                                       Text="Windows Dynamic Island v1.5.0"
                                                       Foreground="#F8FAFC"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock x:Name="SettingsUpdateSubText"
                                                       Text="Memeriksa pembaruan otomatis dari GitHub Releases"
                                                       Foreground="#94A3B8"
                                                       FontSize="11"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="SettingsCheckUpdateBtn"
                                                    Style="{StaticResource IslandIconButtonStyle}"
                                                    Padding="12,6"
                                                    Click="OnCheckUpdateClicked">
                                                <TextBlock x:Name="SettingsCheckUpdateBtnText" Text="Cek Update" FontSize="11.5" FontWeight="SemiBold"/>
                                            </Button>
                                            <Button x:Name="SettingsInstallUpdateBtn"
                                                    Style="{StaticResource IslandIconButtonStyle}"
                                                    Background="#2822C55E"
                                                    BorderBrush="#5522C55E"
                                                    Padding="12,6"
                                                    Margin="8,0,0,0"
                                                    Visibility="Collapsed"
                                                    Click="OnInstallUpdateClicked">
                                                <TextBlock Text="Update Sekarang" Foreground="#34D399" FontSize="11.5" FontWeight="Bold"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- ===================================================== -->
                            <!-- PAGE 1: DISPLAY                                       -->
                            <!-- ===================================================== -->
                            <StackPanel x:Name="PageDisplay" Visibility="Collapsed">
                                <TextBlock Text="Screen &amp; Behavior"
                                           Foreground="#64748B"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Margin="2,0,0,6"/>

                                <Border Background="#1F1F25"
                                        BorderBrush="#1AFFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="16,14">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Auto-hide in Fullscreen"
                                                           Foreground="#F8FAFC"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="Sembunyikan Dynamic Island otomatis saat bermain game atau video layar penuh"
                                                           Foreground="#94A3B8"
                                                           FontSize="11"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkAutoHideFullScreen"
                                                      Grid.Column="1"
                                                      Style="{StaticResource AppleToggleSwitchStyle}"
                                                      VerticalAlignment="Center"
                                                      Click="OnSettingToggleClicked"/>
                                        </Grid>

                                        <Border Height="1" Background="#14FFFFFF" Margin="0,14"/>

                                        <TextBlock Text="Top Screen Offset"
                                                   Foreground="#F8FAFC"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Jarak vertikal Dynamic Island dari tepi paling atas layar monitor"
                                                   Foreground="#94A3B8"
                                                   FontSize="11"
                                                   Margin="0,2,0,10"/>

                                        <Border Background="#141418"
                                                BorderBrush="#1AFFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="2">
                                            <UniformGrid Columns="5">
                                                <RadioButton x:Name="Offset0Btn" GroupName="TopOffset" Style="{StaticResource AppleSegmentOptionStyle}" Content="0 px (Flush)" Tag="0" Click="OnTopOffsetClicked"/>
                                                <RadioButton x:Name="Offset2Btn" GroupName="TopOffset" Style="{StaticResource AppleSegmentOptionStyle}" Content="2 px" Tag="2" Click="OnTopOffsetClicked"/>
                                                <RadioButton x:Name="Offset4Btn" GroupName="TopOffset" Style="{StaticResource AppleSegmentOptionStyle}" Content="4 px" Tag="4" Click="OnTopOffsetClicked"/>
                                                <RadioButton x:Name="Offset8Btn" GroupName="TopOffset" Style="{StaticResource AppleSegmentOptionStyle}" Content="8 px" Tag="8" Click="OnTopOffsetClicked"/>
                                                <RadioButton x:Name="Offset12Btn" GroupName="TopOffset" Style="{StaticResource AppleSegmentOptionStyle}" Content="12 px" Tag="12" Click="OnTopOffsetClicked"/>
                                            </UniformGrid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ===================================================== -->
                            <!-- PAGE 2: APPEARANCE                                    -->
                            <!-- ===================================================== -->
                            <StackPanel x:Name="PageAppearance" Visibility="Collapsed">
                                <TextBlock Text="Glassmorphism &amp; Accent"
                                           Foreground="#64748B"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Margin="2,0,0,6"/>

                                <Border Background="#1F1F25"
                                        BorderBrush="#1AFFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="16,14">
                                    <StackPanel>
                                        <TextBlock Text="Accent Theme"
                                                   Foreground="#F8FAFC"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Warna aksen utama untuk cahaya ambient, garis simpan, dan indikator"
                                                   Foreground="#94A3B8"
                                                   FontSize="11"
                                                   Margin="0,2,0,10"/>

                                        <Border Background="#141418"
                                                BorderBrush="#1AFFFFFF"
