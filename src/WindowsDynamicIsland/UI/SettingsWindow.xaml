                                                        Click="OnOpenBluetoothSettingsClick">
                                                    <TextBlock Text="Pair Perangkat" Foreground="#38BDF8" FontSize="11" FontWeight="Bold"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="HUD &amp; Toast Notifications"
                                           Foreground="#64748B"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Margin="2,0,0,6"/>

                                <Border Background="#1F1F25"
                                        BorderBrush="#1AFFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="16,14">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Volume &amp; Brightness HUD"
                                                           Foreground="#F8FAFC"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="Popup slider interaktif saat menekan tombol volume atau kecerahan"
                                                           Foreground="#94A3B8"
                                                           FontSize="11"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkVolumeBrightnessHud"
                                                      Grid.Column="1"
                                                      Style="{StaticResource AppleToggleSwitchStyle}"
                                                      VerticalAlignment="Center"
                                                      Click="OnSettingToggleClicked"/>
                                        </Grid>

                                        <Border Height="1" Background="#14FFFFFF" Margin="0,14"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Battery &amp; Charger Popup"
                                                           Foreground="#F8FAFC"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="Notifikasi visual baterai saat charger dipasang atau dilepas"
                                                           Foreground="#94A3B8"
                                                           FontSize="11"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkBatteryToast"
                                                      Grid.Column="1"
                                                      Style="{StaticResource AppleToggleSwitchStyle}"
                                                      VerticalAlignment="Center"
                                                      Click="OnSettingToggleClicked"/>
                                        </Grid>

                                        <Border Height="1" Background="#14FFFFFF" Margin="0,14"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Bluetooth Connection Popup"
                                                           Foreground="#F8FAFC"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="Popup otomatis saat perangkat Bluetooth terhubung atau terputus"
                                                           Foreground="#94A3B8"
                                                           FontSize="11"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkBluetoothToast"
                                                      Grid.Column="1"
                                                      Style="{StaticResource AppleToggleSwitchStyle}"
                                                      VerticalAlignment="Center"
                                                      Click="OnSettingToggleClicked"/>
                                        </Grid>

                                        <Border Height="1" Background="#14FFFFFF" Margin="0,14"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="System &amp; App Notifications"
                                                           Foreground="#F8FAFC"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="Tampilkan notifikasi WhatsApp &amp; sistem di Dynamic Island"
                                                           Foreground="#94A3B8"
                                                           FontSize="11"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkSystemNotifToast"
                                                      Grid.Column="1"
                                                      Style="{StaticResource AppleToggleSwitchStyle}"
                                                      VerticalAlignment="Center"
                                                      Click="OnSettingToggleClicked"/>
                                        </Grid>

                                        <Border Height="1" Background="#14FFFFFF" Margin="0,14"/>

                                        <TextBlock Text="Popup Display Duration"
                                                   Foreground="#F8FAFC"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Lama notifikasi tampil sebelum kembali ke tampilan normal (10s) lalu simpan"
                                                   Foreground="#94A3B8"
                                                   FontSize="11"
                                                   Margin="0,2,0,10"/>

                                        <Border Background="#141418"
                                                BorderBrush="#1AFFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="2">
                                            <UniformGrid Columns="4">
                                                <RadioButton x:Name="Toast20Btn" GroupName="ToastDur" Style="{StaticResource AppleSegmentOptionStyle}" Content="2.0 Detik" Tag="2.0" Click="OnToastDurationClicked"/>
                                                <RadioButton x:Name="Toast28Btn" GroupName="ToastDur" Style="{StaticResource AppleSegmentOptionStyle}" Content="2.8 Detik" Tag="2.8" Click="OnToastDurationClicked"/>
                                                <RadioButton x:Name="Toast40Btn" GroupName="ToastDur" Style="{StaticResource AppleSegmentOptionStyle}" Content="4.0 Detik" Tag="4.0" Click="OnToastDurationClicked"/>
                                                <RadioButton x:Name="Toast50Btn" GroupName="ToastDur" Style="{StaticResource AppleSegmentOptionStyle}" Content="5.0 Detik" Tag="5.0" Click="OnToastDurationClicked"/>
                                            </UniformGrid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
