                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Margin="2,0,0,6"/>

                                <Border Background="#1F1F25"
                                        BorderBrush="#1AFFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="16,14"
                                        Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="{Binding [Settings_PlacementStyle], Source={x:Static svc:LocalizationService.Instance}}"
