                                                   Foreground="#94A3B8"
                                                   FontSize="11"
                                                   Margin="0,2,0,10"/>

                                        <Border Background="#141418"
                                                BorderBrush="#1AFFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="2">
                                            <UniformGrid Columns="2">
                                                <RadioButton x:Name="ModeNotchBtn" GroupName="PlacementStyle" Style="{StaticResource AppleSegmentOptionStyle}" Content="{Binding [Settings_NotchMode], Source={x:Static svc:LocalizationService.Instance}}" Tag="Notch" Click="OnPlacementStyleClicked"/>
                                                <RadioButton x:Name="ModePunchHoleBtn" GroupName="PlacementStyle" Style="{StaticResource AppleSegmentOptionStyle}" Content="{Binding [Settings_PunchHoleMode], Source={x:Static svc:LocalizationService.Instance}}" Tag="PunchHole" Click="OnPlacementStyleClicked"/>
