<Window x:Class="WindowsDynamicIsland.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pengaturan — Windows Dynamic Island"
        Icon="pack://application:,,,/Assets/app_icon.ico"
        Width="740"
        Height="530"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Margin="16">
        <!-- Main macOS System Settings Window Frame -->
        <Border x:Name="SettingsOuterFrame"
                Background="#16161A"
                BorderBrush="#26FFFFFF"
                BorderThickness="1"
                CornerRadius="14"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.68" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="206"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ========================================================= -->
                <!-- LEFT SIDEBAR (macOS Ventura / Sequoia Style Navigation)   -->
                <!-- ========================================================= -->
                <Border x:Name="SettingsSidebarBorder"
                        Grid.Column="0"
                        Background="#111114"
                        CornerRadius="14,0,0,14"
                        MouseLeftButtonDown="OnTitleBarDragMove">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Top-Left macOS Traffic Light Buttons -->
                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="16,0,0,0">
                            <!-- Close Button (Red) -->
                            <Button Width="12" Height="12"
                                    Cursor="Hand"
                                    ToolTip="Tutup Pengaturan"
                                    Click="OnCloseButtonClick"
                                    Margin="0,0,8,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CloseDot"
                                                Width="12" Height="12"
                                                CornerRadius="6"
                                                Background="{DynamicResource SettingsTrafficCloseBgBrush}"
                                                BorderBrush="#30000000"
                                                BorderThickness="0.5"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CloseDot" Property="Background" Value="{DynamicResource SettingsTrafficCloseHoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Minimize Button (Amber / Graphite) -->
                            <Button Width="12" Height="12"
                                    Cursor="Hand"
                                    ToolTip="Minimize"
                                    Click="OnMinimizeButtonClick"
                                    Margin="0,0,8,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="MinDot"
                                                Width="12" Height="12"
                                                CornerRadius="6"
                                                Background="{DynamicResource SettingsTrafficMinBgBrush}"
                                                BorderBrush="#30000000"
                                                BorderThickness="0.5"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="MinDot" Property="Background" Value="{DynamicResource SettingsTrafficMinHoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <!-- 10 Sidebar Categories with Squircle Icon Badges -->
                        <ScrollViewer Grid.Row="1"
                                      Style="{StaticResource AppleScrollViewerStyle}"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="10,2,10,10">
                            <StackPanel>
                                <!-- 0. General -->
                                <RadioButton x:Name="NavGeneralBtn"
                                             GroupName="SettingsNav"
                                             Style="{StaticResource AppleSidebarNavButtonStyle}"
                                             IsChecked="True"
                                             Tag="0"
                                             Checked="OnNavCategoryChecked">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="NavBadge0" Width="22" Height="22" CornerRadius="6" Background="#64748B" Margin="0,0,10,0">
                                            <Path Data="{StaticResource GeomSettingsGear}" Width="12" Height="12" Stretch="Uniform" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="General" FontSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <!-- 1. Display -->
                                <RadioButton x:Name="NavDisplayBtn"
                                             GroupName="SettingsNav"
                                             Style="{StaticResource AppleSidebarNavButtonStyle}"
                                             Tag="1"
                                             Checked="OnNavCategoryChecked">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="NavBadge1" Width="22" Height="22" CornerRadius="6" Background="#8B5CF6" Margin="0,0,10,0">
                                            <Path Data="{StaticResource GeomDisplayMonitor}" Width="12" Height="12" Stretch="Uniform" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Display" FontSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <!-- 2. Appearance -->
                                <RadioButton x:Name="NavAppearanceBtn"
                                             GroupName="SettingsNav"
                                             Style="{StaticResource AppleSidebarNavButtonStyle}"
                                             Tag="2"
                                             Checked="OnNavCategoryChecked">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="NavBadge2" Width="22" Height="22" CornerRadius="6" Background="#475569" Margin="0,0,10,0">
                                            <Path Data="{StaticResource GeomAppearanceSparkle}" Width="12" Height="12" Stretch="Uniform" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Appearance" FontSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <!-- 3. Music and lyrics -->
                                <RadioButton x:Name="NavMusicBtn"
                                             GroupName="SettingsNav"
                                             Style="{StaticResource AppleSidebarNavButtonStyle}"
                                             Tag="3"
                                             Checked="OnNavCategoryChecked">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="NavBadge3" Width="22" Height="22" CornerRadius="6" Background="#F43F5E" Margin="0,0,10,0">
                                            <Path Data="{StaticResource GeomMusic}" Width="11.5" Height="11.5" Stretch="Uniform" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Music and lyrics" FontSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <!-- 4. To-do -->
                                <RadioButton x:Name="NavTodoBtn"
                                             GroupName="SettingsNav"
                                             Style="{StaticResource AppleSidebarNavButtonStyle}"
                                             Tag="4"
                                             Checked="OnNavCategoryChecked">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="NavBadge4" Width="22" Height="22" CornerRadius="6" Background="#22C55E" Margin="0,0,10,0">
                                            <Path Data="{StaticResource GeomChecklist}" Width="11.5" Height="11.5" Stretch="Uniform" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="To-do" FontSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <!-- 5. Calendar -->
                                <RadioButton x:Name="NavCalendarBtn"
                                             GroupName="SettingsNav"
                                             Style="{StaticResource AppleSidebarNavButtonStyle}"
                                             Tag="5"
                                             Checked="OnNavCategoryChecked">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="NavBadge5" Width="22" Height="22" CornerRadius="6" Background="#EF4444" Margin="0,0,10,0">
                                            <Path Data="{StaticResource GeomCalendar}" Width="11.5" Height="11.5" Stretch="Uniform" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Calendar" FontSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <!-- 6. Pomodoro -->
                                <RadioButton x:Name="NavPomodoroBtn"
                                             GroupName="SettingsNav"
                                             Style="{StaticResource AppleSidebarNavButtonStyle}"
                                             Tag="6"
                                             Checked="OnNavCategoryChecked">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="NavBadge6" Width="22" Height="22" CornerRadius="6" Background="#F97316" Margin="0,0,10,0">
                                            <Path Data="{StaticResource GeomFocusTimer}" Width="12" Height="12" Stretch="Uniform" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Pomodoro" FontSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <!-- 7. Water -->
                                <RadioButton x:Name="NavWaterBtn"
                                             GroupName="SettingsNav"
                                             Style="{StaticResource AppleSidebarNavButtonStyle}"
                                             Tag="7"
                                             Checked="OnNavCategoryChecked">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="NavBadge7" Width="22" Height="22" CornerRadius="6" Background="#3B82F6" Margin="0,0,10,0">
                                            <Path Data="{StaticResource GeomWaterDrop}" Width="11.5" Height="11.5" Stretch="Uniform" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Water" FontSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <!-- 8. Shelf -->
                                <RadioButton x:Name="NavShelfBtn"
                                             GroupName="SettingsNav"
                                             Style="{StaticResource AppleSidebarNavButtonStyle}"
                                             Tag="8"
                                             Checked="OnNavCategoryChecked">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="NavBadge8" Width="22" Height="22" CornerRadius="6" Background="#F59E0B" Margin="0,0,10,0">
                                            <Path Data="{StaticResource GeomFolderTray}" Width="11.5" Height="11.5" Stretch="Uniform" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Shelf" FontSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <!-- 9. HUD & popups -->
                                <RadioButton x:Name="NavHudBtn"
                                             GroupName="SettingsNav"
                                             Style="{StaticResource AppleSidebarNavButtonStyle}"
                                             Tag="9"
                                             Checked="OnNavCategoryChecked">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="NavBadge9" Width="22" Height="22" CornerRadius="6" Background="#0EA5E9" Margin="0,0,10,0">
                                            <Path Data="{StaticResource GeomHudLayers}" Width="12" Height="12" Stretch="Uniform" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="HUD &amp; popups" FontSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Bottom Version & Quick Tuck Footer -->
                        <Border Grid.Row="2"
                                BorderBrush="#14FFFFFF"
                                BorderThickness="0,1,0,0"
                                Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Dynamic Island" Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="SidebarVersionText" Text="v1.5.0 • macOS Edition" Foreground="#64748B" FontSize="9.5"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Vertical Hairline Divider -->
                <Border x:Name="SettingsDividerBorder" Grid.Column="1" Background="#1EFFFFFF"/>

                <!-- ========================================================= -->
                <!-- RIGHT CONTENT PANE                                        -->
                <!-- ========================================================= -->
                <Grid x:Name="SettingsContentPaneGrid" Grid.Column="2" Background="#16161A">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="54"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Category Header Bar (Draggable) -->
                    <Border Grid.Row="0"
                            Background="Transparent"
                            Padding="26,0,22,0"
                            MouseLeftButtonDown="OnTitleBarDragMove">
                        <Grid>
                            <TextBlock x:Name="PageHeaderTitleText"
                                       Text="General"
                                       Foreground="#F8FAFC"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                            <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource IslandIconButtonStyle}"
                                    Padding="10,5"
                                    Click="OnCloseButtonClick">
                                <TextBlock Text="Selesai" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Scrollable Settings Content -->
                    <ScrollViewer Grid.Row="1"
                                  Style="{StaticResource AppleScrollViewerStyle}"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="26,2,26,24">
                        <Grid x:Name="SettingsPagesHostGrid">
                            <!-- ===================================================== -->
                            <!-- PAGE 0: GENERAL & SYSTEM CONTROL CENTER               -->
                            <!-- ===================================================== -->
                            <StackPanel x:Name="PageGeneral" Visibility="Visible">
                                <TextBlock Text="System Control Center"
                                           Foreground="#64748B"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Margin="2,0,0,6"/>

                                <!-- System Dashboard Card (Moved from Notch Sistem Tab into Settings!) -->
                                <Border Background="#1F1F25"
                                        BorderBrush="#1AFFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14,13"
                                        Margin="0,0,0,18">
                                    <StackPanel>
                                        <!-- Row 0: Speaker Volume & Screen Brightness Interactive Sliders -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Speaker Volume Card -->
                                            <Border Grid.Column="0"
                                                    Background="#151519"
                                                    BorderBrush="#1EFFFFFF"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="12,9"
                                                    Margin="0,0,5,0">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,7">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Path x:Name="SettingsVolIconPath"
                                                              Grid.Column="0"
                                                              Data="{StaticResource GeomSpeakerOn}"
                                                              Width="11.5" Height="11.5"
                                                              Stretch="Uniform"
                                                              Fill="#38BDF8"
                                                              Margin="0,0,6,0"
                                                              VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="SettingsVolLabelText"
                                                                   Grid.Column="1"
                                                                   Text="SPEAKER"
                                                                   Foreground="#CBD5E1"
                                                                   FontSize="10.5"
                                                                   FontWeight="Bold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="SettingsVolPercentText"
                                                                   Grid.Column="2"
                                                                   Text="50%"
                                                                   Foreground="#38BDF8"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>

                                                    <Grid x:Name="SettingsVolSliderHitArea"
                                                          Height="16"
                                                          Background="Transparent"
                                                          Cursor="Hand"
                                                          MouseLeftButtonDown="OnSettingsVolumeMouseDown"
                                                          MouseMove="OnSettingsVolumeMouseMove"
                                                          MouseLeftButtonUp="OnSettingsVolumeMouseUp">
                                                        <Border x:Name="SettingsVolTrackBorder"
                                                                Height="8"
                                                                CornerRadius="4"
                                                                Background="#26FFFFFF"
                                                                ClipToBounds="True"
                                                                VerticalAlignment="Center">
                                                            <Border x:Name="SettingsVolFillBorder"
                                                                    HorizontalAlignment="Left"
                                                                    Width="90"
                                                                    Height="8"
                                                                    CornerRadius="4"
                                                                    Background="#38BDF8"/>
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- Brightness Slider Card -->
                                            <Border Grid.Column="1"
                                                    Background="#151519"
                                                    BorderBrush="#1EFFFFFF"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="12,9"
                                                    Margin="5,0,0,0">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,7">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Path x:Name="SettingsBrtIconPath"
                                                              Grid.Column="0"
                                                              Data="{StaticResource GeomBrightnessSun}"
                                                              Width="11.5" Height="11.5"
                                                              Stretch="Uniform"
                                                              Fill="#FBBF24"
                                                              Margin="0,0,6,0"
                                                              VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="KECERAHAN LAYAR"
                                                                   Foreground="#CBD5E1"
                                                                   FontSize="10.5"
                                                                   FontWeight="Bold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="SettingsBrtPercentText"
                                                                   Grid.Column="2"
                                                                   Text="50%"
                                                                   Foreground="#FBBF24"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>

                                                    <Grid x:Name="SettingsBrtSliderHitArea"
                                                          Height="16"
                                                          Background="Transparent"
                                                          Cursor="Hand"
                                                          MouseLeftButtonDown="OnSettingsBrightnessMouseDown"
                                                          MouseMove="OnSettingsBrightnessMouseMove"
                                                          MouseLeftButtonUp="OnSettingsBrightnessMouseUp">
                                                        <Border x:Name="SettingsBrtTrackBorder"
                                                                Height="8"
                                                                CornerRadius="4"
                                                                Background="#26FFFFFF"
                                                                ClipToBounds="True"
                                                                VerticalAlignment="Center">
                                                            <Border x:Name="SettingsBrtFillBorder"
                                                                    HorizontalAlignment="Left"
                                                                    Width="90"
                                                                    Height="8"
                                                                    CornerRadius="4"
                                                                    Background="#FBBF24"/>
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Row 1: Hardware Telemetry Cards (Battery/Wi-Fi & Camera/Mic/RAM/CPU) -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Background="#151519"
                                                    BorderBrush="#1EFFFFFF"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="12,8"
                                                    Margin="0,0,5,0">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path x:Name="SettingsSysBoltIcon"
                                                              Data="{StaticResource GeomBolt}"
                                                              Width="10" Height="11"
                                                              Stretch="Uniform"
                                                              Fill="#22C55E"
                                                              Margin="0,0,5,0"
                                                              VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="SettingsSysBatteryText"
                                                                   Text="Charging • 100%"
                                                                   Foreground="#F8FAFC"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="SettingsSysNetworkText"
                                                               Text="Wi-Fi Terhubung"
                                                               Foreground="#94A3B8"
                                                               FontSize="10.5"
                                                               Margin="0,2,0,0"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="1"
                                                    Background="#151519"
                                                    BorderBrush="#1EFFFFFF"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="12,8"
                                                    Margin="5,0,0,0">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path x:Name="SettingsSysPrivacyIcon"
                                                              Data="{StaticResource GeomShield}"
                                                              Width="10.5" Height="11"
                                                              Stretch="Uniform"
                                                              Fill="#22C55E"
                                                              Margin="0,0,5,0"
                                                              VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="SettingsSysPrivacyText"
                                                                   Text="Kamera &amp; Mic Aman (Idle)"
                                                                   Foreground="#22C55E"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="SettingsSysMemoryText"
                                                               Text="RAM: 26 MB • 0% CPU Idle"
                                                               Foreground="#94A3B8"
                                                               FontSize="10.5"
                                                               Margin="0,2,0,0"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Row 2: Quick Action Bar (Sound, Mic, Bluetooth, Simpan, Keluar) -->
                                        <WrapPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource IslandIconButtonStyle}"
                                                    Padding="10,6"
                                                    Margin="0,0,6,0"
                                                    ToolTip="Mute / Unmute Output Audio"
                                                    Click="OnSettingsToggleMuteClick">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path x:Name="SettingsMuteBtnIcon"
                                                          Data="{StaticResource GeomSpeakerOn}"
                                                          Width="11" Height="11"
                                                          Stretch="Uniform"
                                                          Fill="#38BDF8"
                                                          Margin="0,0,5,0"
                                                          VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="SettingsMuteBtnText"
                                                               Text="Sound: ON"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Style="{StaticResource IslandIconButtonStyle}"
                                                    Padding="10,6"
                                                    Margin="0,0,6,0"
                                                    ToolTip="Mute / Unmute Mikrofon"
                                                    Click="OnSettingsToggleMicClick">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path x:Name="SettingsMicBtnIcon"
                                                          Data="{StaticResource GeomMicOn}"
                                                          Width="11" Height="11"
                                                          Stretch="Uniform"
                                                          Fill="#22C55E"
                                                          Margin="0,0,5,0"
                                                          VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="SettingsMicBtnText"
                                                               Text="Mic: ON"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Style="{StaticResource IslandIconButtonStyle}"
                                                    Padding="10,6"
                                                    Margin="0,0,6,0"
                                                    ToolTip="Klik: Nyalakan / Matikan Radio Bluetooth • Klik Kanan: Buka Pengaturan Pair Bluetooth"
                                                    Click="OnSettingsToggleBluetoothClick"
                                                    MouseRightButtonUp="OnSettingsBluetoothRightClick">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path x:Name="SettingsBtBtnIcon"
                                                          Data="{StaticResource GeomBluetooth}"
                                                          Width="11" Height="11"
                                                          Stretch="Uniform"
                                                          Fill="#38BDF8"
                                                          Margin="0,0,5,0"
                                                          VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="SettingsBtBtnText"
                                                               Text="Bluetooth: ON"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Style="{StaticResource IslandIconButtonStyle}"
                                                    Padding="10,6"
                                                    Margin="0,0,6,0"
                                                    ToolTip="Lipat / Simpan Dynamic Island ke tepi atas layar"
                                                    Click="OnSettingsTuckIslandClick">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource GeomChevronUp}"
                                                          Width="10" Height="10"
                                                          Stretch="Uniform"
                                                          Fill="#CBD5E1"
                                                          Margin="0,0,4.5,0"
                                                          VerticalAlignment="Center"/>
                                                    <TextBlock Text="Simpan"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Style="{StaticResource IslandIconButtonStyle}"
                                                    Padding="10,6"
                                                    ToolTip="Tutup aplikasi Windows Dynamic Island"
                                                    Click="OnSettingsExitAppClick">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path x:Name="SettingsExitBtnIcon"
                                                          Data="{StaticResource GeomClosePower}"
                                                          Width="10" Height="10"
                                                          Stretch="Uniform"
                                                          Fill="#F87171"
                                                          Margin="0,0,4.5,0"
                                                          VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="SettingsExitBtnText"
                                                               Text="Keluar"
                                                               Foreground="#F87171"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Startup"
                                           Foreground="#64748B"
