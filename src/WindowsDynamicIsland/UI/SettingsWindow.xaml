                                                    </StackPanel>
                                                </RadioButton>
                                                <RadioButton x:Name="SurfCarbonBtn" GroupName="SurfaceTheme" Style="{StaticResource AppleSegmentOptionStyle}" Tag="MidnightCarbon" Click="OnSurfaceThemeClicked">
