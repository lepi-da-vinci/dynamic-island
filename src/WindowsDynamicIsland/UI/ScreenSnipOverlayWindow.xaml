<Window x:Class="WindowsDynamicIsland.UI.ScreenSnipOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        Background="#000000"
        KeyDown="OnWindowKeyDown"
        MouseLeftButtonDown="OnOverlayMouseDown"
        MouseMove="OnOverlayMouseMove"
        MouseLeftButtonUp="OnOverlayMouseUp"
        MouseRightButtonDown="OnOverlayRightClick">
    <Grid>
        <!-- Frozen Desktop Snapshot -->
        <Image x:Name="BackdropImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>

        <!-- Dimming Mask with Dynamic Cutout for OCR Selection -->
        <Path x:Name="SelectionDimMask" Fill="#72000000" IsHitTestVisible="False"/>

        <!-- OCR Selection Border & Size Readout -->
        <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False">
            <Border x:Name="SelectionBox"
                    Visibility="Collapsed"
                    BorderBrush="#38BDF8"
                    BorderThickness="2"
                    CornerRadius="4"
                    Background="#1038BDF8"/>

            <Border x:Name="SizePill"
                    Visibility="Collapsed"
                    Background="#E609090B"
                    BorderBrush="#30FFFFFF"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8,3">
                <TextBlock x:Name="SizePillText" Foreground="#F8FAFC" FontSize="11" FontWeight="SemiBold"/>
            </Border>

            <!-- Color Eyedropper Magnifier Card -->
            <Border x:Name="EyedropperCard"
                    Visibility="Collapsed"
                    Width="156"
                    Background="#EE09090B"
                    BorderBrush="#30FFFFFF"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.55" Color="#000000"/>
                </Border.Effect>
                <StackPanel Orientation="Vertical">
                    <Grid Width="138" Height="78" ClipToBounds="True">
                        <Border CornerRadius="8" BorderBrush="#26FFFFFF" BorderThickness="1" ClipToBounds="True">
                            <Image x:Name="MagnifierImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Border>
                        <!-- Center Target Pixel Crosshair -->
                        <Border Width="8" Height="8" BorderBrush="#FFFFFF" BorderThickness="1.2"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent"/>
                    </Grid>
                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="ColorSwatchBorder" Grid.Column="0" Width="22" Height="22" CornerRadius="6"
                                BorderBrush="#40FFFFFF" BorderThickness="1" Background="#38BDF8" Margin="0,0,8,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="HexReadoutText" Text="#38BDF8" Foreground="#F8FAFC" FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="RgbReadoutText" Text="56, 189, 248" Foreground="#94A3B8" FontSize="9.5"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Canvas>

        <!-- Floating Instruction Notch Pill -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,18,0,0"
                Background="#E609090B"
                BorderBrush="#2AFFFFFF"
                BorderThickness="1"
                CornerRadius="16"
                Padding="14,7"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
            </Border.Effect>
            <TextBlock x:Name="InstructionText"
                       Text="Drag region to copy text (OCR) • ESC to cancel"
                       Foreground="#F8FAFC"
                       FontSize="12"
                       FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>
