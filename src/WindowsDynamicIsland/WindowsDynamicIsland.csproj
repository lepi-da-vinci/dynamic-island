<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app_icon.ico</ApplicationIcon>
    <AssemblyName>WindowsDynamicIsland</AssemblyName>
    <RootNamespace>WindowsDynamicIsland</RootNamespace>
    <OptimizationPreference>Speed</OptimizationPreference>
    <Product>Windows Dynamic Island</Product>
    <Company>Lepi Da Vinci</Company>
    <Version>2.1.0</Version>
    <FileVersion>2.1.0.0</FileVersion>
    <AssemblyVersion>2.1.0.0</AssemblyVersion>
    <Description>Native Dynamic Island for Windows 10 and 11</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WindowsDynamicIsland.Tests" />
    <Resource Include="Assets\app_icon.ico" />
    <Resource Include="Assets\app_logo.png" />
  </ItemGroup>

  <!-- Automatically stop any previous running instance before build/run so MSB3027 file-lock never happens -->
  <Target Name="StopRunningDynamicIsland" BeforeTargets="BeforeBuild;PrepareForBuild;CopyFilesToOutputDirectory">
    <Exec Command="taskkill /F /IM WindowsDynamicIsland.exe >nul 2>&amp;1"
          IgnoreExitCode="true"
          EchoOff="true" />
  </Target>

  <!-- Ensure design-time *.g.i.cs exists for Visual Studio / VS Code Roslyn IntelliSense -->
  <Target Name="EnsureDesignTimeXamlGeneratedFiles" AfterTargets="MarkupCompilePass2">
    <ItemGroup>
      <_GeneratedXamlCs Include="$(IntermediateOutputPath)**\*.g.cs" />
    </ItemGroup>
    <Copy SourceFiles="@(_GeneratedXamlCs)"
          DestinationFiles="@(_GeneratedXamlCs->'%(RootDir)%(Directory)%(Filename).i.cs')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
