<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>WindowsDynamicIsland</AssemblyName>
    <RootNamespace>WindowsDynamicIsland</RootNamespace>
    <OptimizationPreference>Speed</OptimizationPreference>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <Product>Windows Dynamic Island</Product>
    <Company>WindowsDynamicIsland</Company>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Description>Native Dynamic Island for Windows 10 and 11</Description>
  </PropertyGroup>

  <!-- Automatically stop any previous running instance before build/run so MSB3027 file-lock never happens -->
  <Target Name="StopRunningDynamicIsland" BeforeTargets="BeforeBuild;PrepareForBuild;CopyFilesToOutputDirectory">
    <Exec Command="powershell -NoProfile -Command &quot;Get-Process -Name 'WindowsDynamicIsland' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue&quot;"
          IgnoreExitCode="true"
           EchoOff="true" />
  </Target>

</Project>
